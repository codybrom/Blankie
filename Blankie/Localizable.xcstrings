    "Choose the sounds you want to include in this preset. You can select as many as you like!" : {
      "comment" : "Onboarding instruction explaining that the user can pick any number of sounds to include in a preset.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wählen Sie die Sounds aus, die Sie in diese Voreinstellung aufnehmen möchten. Sie können so viele auswählen, wie Sie möchten!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the sounds you want to include in this preset. You can select as many as you like!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the sounds you want to include in this preset. You can select as many as you like!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige los sonidos que quieres incluir en este sonido prediseñado. ¡Puedes seleccionar todos los que quieras!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez les sons à inclure dans ce préréglage. Vous pouvez en sélectionner autant que vous le souhaitez !"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Válaszd ki a sablonhoz hozzáadni kívánt hangokat. Annyit jelölhetsz ki, amennyit csak szeretnél!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scegli i suoni da includere in questa configurazione. Puoi selezionarne quanti vuoi!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このプリセットに含めたいサウンドを選択してください。好きなだけ選べます！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 프리셋에 포함할 소리를 선택하세요. 원하는 만큼 선택할 수 있어요!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wybierz dźwięki, które chcesz dodać do tego presetu. Możesz wybrać ich dowolnie wiele!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escolha os sons que quer incluir nesta pré-definição. Pode selecionar quantos quiser!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu ön ayara dahil etmek istediğiniz sesleri seçin. İstediğiniz kadar seçebilirsiniz!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "选择您想要包含在此预设中的音效。您可以随意选择任意数量！"
