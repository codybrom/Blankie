    "If disabled, Blankie will immediately play your most recent preset on launch" : {
      "comment" : "Help text for the 'Always start paused' toggle, explaining that disabling it plays the most recent preset on launch.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn deaktiviert, wird Blankie Ihre letzte Voreinstellung beim Start sofort abspielen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If disabled, Blankie will immediately play your most recent preset on launch"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If disabled, Blankie will immediately play your most recent preset on launch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está deshabilitado, Blankie reproducirá inmediatamente su configuración más reciente al lanzar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si désactivé, Blankie jouera immédiatement votre préréglage le plus récent au lancement"
