        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arrastra los pines para colocarlos. Toca un pin para quitarlo del mapa espacial. Las posiciones no se guardan entre sesiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faites glisser les épingles pour les placer. Touchez une épingle pour la retirer de la carte spatiale. Les placements ne sont pas conservés entre les sessions."
