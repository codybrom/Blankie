    "%lld" : {
      "comment" : "A standalone count of the selected sounds, shown as a number on its own. %lld is the number of sounds.",
      "shouldTranslate" : false
    },
    "%lld custom sounds are used only by '%@'. Delete them too?" : {
      "comment" : "A confirmation dialog message (plural) asking whether to also delete custom sounds used only by the preset being deleted. The first argument is the count, the second is the preset name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld eigene Sounds werden nur von „%2$@“ verwendet. Auch diese löschen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld custom sounds are used only by '%2$@'. Delete them too?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld custom sounds are used only by '%2$@'. Delete them too?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld sonidos personalizados solo los usa '%2$@'. ¿Eliminarlos también?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld sons personnalisés sont utilisés uniquement par « %2$@ ». Les supprimer aussi ?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld egyéni hangot csak a(z) „%2$@” használ. Ezeket is törlöd?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld suoni personalizzati sono usati solo da \"%2$@\". Eliminare anche quelli?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld個のカスタムサウンドは「%2$@」だけで使われています。これらも削除しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "사용자 소리 %1$lld개가 '%2$@'에서만 사용돼요. 함께 삭제할까요?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld własnych dźwięków jest używanych tylko przez „%2$@”. Usunąć je również?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld sons personalizados são usados apenas por '%2$@'. Apagá-los também?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld özel ses yalnızca '%2$@' tarafından kullanılıyor. Onlar da silinsin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "有 %1$lld 个自定义音效仅由“%2$@”使用。要一并删除吗？"
          }
        }
      }
    },
