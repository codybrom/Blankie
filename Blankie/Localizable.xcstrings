    "%@, in your head, tap to place in space" : {
      "comment" : "VoiceOver label for a sound that isn't placed on the spatial map. %@ is the sound name.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@, im Kopf, zum Platzieren im Raum tippen"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, in your head, tap to place in space"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@, en tu cabeza, toca para colocarlo en el espacio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@, dans votre tête, touchez pour le placer dans l’espace"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@, a fejedben, koppints a térbe helyezéshez"
