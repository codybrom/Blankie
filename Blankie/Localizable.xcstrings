        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Húzd a tűket az elhelyezéshez. Koppints egy tűre, hogy eltávolítsd a térbeli térképről. Az elhelyezések nem maradnak meg a munkamenetek között."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trascina i segnaposto per posizionarli. Tocca un segnaposto per rimuoverlo dalla mappa spaziale. Le posizioni non vengono salvate tra le sessioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ピンをドラッグして配置します。ピンをタップすると空間マップから取り除かれます。配置はセッション間で保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "핀을 드래그하여 배치하세요. 핀을 탭하면 공간 지도에서 제거됩니다. 배치는 세션 간에 저장되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przeciągnij pinezki, aby je rozmieścić. Stuknij pinezkę, aby usunąć ją z mapy przestrzennej. Rozmieszczenie nie jest zapisywane między sesjami."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
