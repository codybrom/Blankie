  "docker.lsp.experimental.vulnerabilityScanning": false,
  "files.associations": {
    "*.css": "css"
  },
  "css.lint.unknownAtRules": "ignore",
  "tailwindCSS.experimental.configFile": {
    "docs/src/styles/global.css": "docs/**"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "always"
  },
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode",
    "editor.formatOnSave": true
  },
  "[xml]": {
    "editor.formatOnSave": false
  },
  "xml.format.enabled": false,
  "markdownlint.config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": false,
    "MD041": false
  },
  "swift.outputChannelLogLevel": "info",
  "swift.sourcekit-lsp.disable": false,
  "swift.diagnosticsCollection": "onlySwiftc",
  "swift.path": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin",
  "swift.swiftEnvironmentVariables": {
    "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
  }
}