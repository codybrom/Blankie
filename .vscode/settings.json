{
  "astro.content-intellisense": true,
  "astro.language-server.ls-path": "docs/node_modules/@astrojs/language-server/bin/nodeServer.js",
  "astro.trace.server": "messages",
  "astro.updateImportsOnFileMove.enabled": true,
  "cSpell.words": [
    "autoplay",
    "aybarsnazlica",
    "Balaji",
    "Balázs",
    "blanki",
    "blanki8n",
    "Blankie",
    "Dizz7",
    "Kristopheros",
    "Polski",
    "Rapp",
    "carplay",
    "Chuscas",
    "Chuskas",
    "codybrom",
    "Coelho",
    "davnr",
    "DCARPLAY",
    "Deinitialized",
    "Deutsch",
    "Español",
    "exclamationmark",
    "facebookexternalhit",
    "favoritable",
    "favorited",
    "favoriting",
    "Français",
    "gearshape",
    "healthcheck",
    "INFOPLIST",
    "iphoneos",
    "iphonesimulator",
    "Italiano",
    "jhk0530",
    "Jinhwan",
    "Júlio",
    "kofi",
    "kur1k0",
    "Lockscreen",
    "lufs",
    "Mardojai",
    "nums",
    "Orientationi",
    "papaparse",
    "pbxproj",
    "playform",
    "Português",
    "Reorderable",
    "Sonoma",
    "SORTABLEGRID",
    "subheadline",
    "superview",
    "Türkçe",
    "Twitterbot",
    "Venkatesh's",
    "xcconfig",
    "xcstrings",
    "xmark",
    "yoshida",
    "yournamehere",
    "한국어",
    "日本語",
    "简体中文"
  ],
  "docker.lsp.experimental.vulnerabilityScanning": false,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "css.lint.unknownAtRules": "ignore",
  "tailwindCSS.experimental.configFile": {
    "docs/src/styles/global.css": "docs/**"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "always"
  },
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode",
    "editor.formatOnSave": true
  },
  "[xml]": {
    "editor.formatOnSave": false
  },
  "xml.format.enabled": false,
  "markdownlint.config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": false,
    "MD041": false
  },
  "swift.outputChannelLogLevel": "info",
  "swift.sourcekit-lsp.disable": false,
  "swift.diagnosticsCollection": "onlySwiftc",
  "swift.path": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin",
  "swift.swiftEnvironmentVariables": {
    "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
  }
}