---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { Card } from "@/components/ui/card";
import {
  SlidersHorizontal,
  Bookmark,
  Sparkles,
  Check,
  CloudRain,
  Waves,
  Flame,
  Keyboard,
  LayoutGrid,
  Zap,
  FolderPlus,
  Smartphone,
} from "lucide-react";
import screenshot from "../assets/screenshot.png";
import bg1 from "../assets/bg-1.png";
import bg2 from "../assets/bg-2.png";
import bg3 from "../assets/bg-3.png";

const title = "Features - Blankie";
---

<Layout title={title}>
  <!-- Hero & High-Quality Audio Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <Image src={bg2} alt="" class="size-full object-cover" />
      <div class="absolute inset-0 bg-black/75"></div>
    </div>

    <!-- Hero -->
    <div class="relative mx-auto mt-16 max-w-5xl px-5 py-20 text-center">
      <h1 class="text-4xl/tight font-semibold tracking-tighter md:text-5xl">
        Everything you need for a perfect soundscape
      </h1>
    </div>

    <!-- High-Quality Audio -->
    <div class="relative mx-auto max-w-6xl px-5 pb-12">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="mb-6 flex items-center gap-3 text-3xl font-semibold">
            <SlidersHorizontal
              className="text-primary size-7"
              strokeWidth={1.75}
            />
            High-Quality Audio
          </h2>
          <p class="mb-6 text-lg text-gray-200">
            23 carefully curated ambient sounds recorded in high fidelity. From
            gentle rain and ocean waves to crackling fireplaces and bustling
            coffee shops.
          </p>
          <ul class="space-y-3 text-gray-200">
            <li class="flex items-center gap-3">
              <Check className="text-primary size-5 shrink-0" strokeWidth={2} />
              Individual volume controls for each sound
            </li>
            <li class="flex items-center gap-3">
              <Check className="text-primary size-5 shrink-0" strokeWidth={2} />
              High-quality audio files optimized for long listening
            </li>
            <li class="flex items-center gap-3">
              <Check className="text-primary size-5 shrink-0" strokeWidth={2} />
              Mix and match sounds to create your perfect environment
            </li>
            <li class="flex items-center gap-3">
              <Check className="text-primary size-5 shrink-0" strokeWidth={2} />
              Seamless loops with no gaps or interruptions
            </li>
          </ul>
        </div>
        <div class="flex justify-center">
          <Image
            src={screenshot}
            alt="Blankie interface showing audio controls"
            width={400}
            height={584}
            class="rounded-lg shadow-lg"
            quality={90}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Preset System & macOS Integration Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <Image src={bg3} alt="" class="size-full object-cover" />
      <div class="absolute inset-0 bg-black/75"></div>
    </div>

    <!-- Preset System -->
    <div class="relative mx-auto max-w-6xl px-5 py-12">
      <div
        class="mb-8 grid grid-cols-1 items-center gap-2 lg:grid-cols-2 lg:gap-4"
      >
        <div class="order-2 flex justify-center lg:order-1">
          <Card className="max-w-md gap-0 p-8">
            <div class="space-y-3">
              <div class="rounded-lg bg-black/30 p-3">
                <div class="flex items-center gap-2 font-medium">
                  <CloudRain
                    className="text-primary size-4"
                    strokeWidth={1.75}
                  />
                  Rainy Day Focus
                </div>
                <div class="text-sm text-gray-400">
                  Rain + Storm + Coffee Shop
                </div>
              </div>
              <div class="rounded-lg bg-black/30 p-3">
                <div class="flex items-center gap-2 font-medium">
                  <Waves className="text-primary size-4" strokeWidth={1.75} />
                  Ocean Meditation
                </div>
                <div class="text-sm text-gray-400">Waves + Wind + Boat</div>
              </div>
              <div class="rounded-lg bg-black/30 p-3">
                <div class="flex items-center gap-2 font-medium">
                  <Flame className="text-primary size-4" strokeWidth={1.75} />
                  Cozy Evening
                </div>
                <div class="text-sm text-gray-400">Fireplace + Rain + Wind</div>
              </div>
            </div>
          </Card>
        </div>
        <div class="order-1 lg:order-2">
          <h2 class="mb-6 flex items-center gap-3 text-3xl font-semibold">
            <Bookmark className="text-primary size-7" strokeWidth={1.75} />
            Preset Perfection
          </h2>
          <p class="mb-6 text-lg text-gray-200">
            Save your favorite mixes and switch between them instantly. Perfect
            for different moods, activities or times of day.
          </p>
          <ul class="space-y-3 text-gray-200">
            <li class="flex items-center gap-3">
              <Check className="text-primary size-5 shrink-0" strokeWidth={2} />
              Use unlimited custom presets to save your favorite mixes
            </li>
            <li class="flex items-center gap-3">
              <Check className="text-primary size-5 shrink-0" strokeWidth={2} />
              One-click switching from toolbar preset picker
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- macOS Integration -->
    <div class="relative mx-auto mb-6 max-w-6xl px-5 pb-12">
      <div class="mb-12 text-center">
        <h2
          class="mb-6 flex items-center justify-center gap-3 text-3xl font-semibold"
        >
          <span class="text-primary leading-none" aria-hidden="true"></span>
          Made for macOS
        </h2>
        <p class="mx-auto max-w-3xl text-lg text-gray-200">
          Blankie integrates seamlessly with macOS, feeling like a native part
          of your system. It just works the way you'd expect.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        <Card className="gap-0 p-6">
          <Keyboard className="text-primary mb-4 size-7" strokeWidth={1.75} />
          <h3 class="mb-3 text-lg font-semibold">Media Controls</h3>
          <p class="text-gray-200">
            Works with media keys, AirPods, and other Bluetooth headphones for
            seamless control.
          </p>
        </Card>
        <Card className="gap-0 p-6">
          <LayoutGrid className="text-primary mb-4 size-7" strokeWidth={1.75} />
          <h3 class="mb-3 text-lg font-semibold">Control Center</h3>
          <p class="text-gray-200">
            See now playing information and preset names in the macOS Control
            Center.
          </p>
        </Card>
        <Card className="gap-0 p-6">
          <Zap className="text-primary mb-4 size-7" strokeWidth={1.75} />
          <h3 class="mb-3 text-lg font-semibold">Native Performance</h3>
          <p class="text-gray-200">
            Built with Swift for optimal performance and energy efficiency on
            Apple Silicon and Intel Macs.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <!-- Coming Soon & CTA Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <Image src={bg1} alt="" class="size-full object-cover" />
      <div class="absolute inset-0 bg-black/80"></div>
    </div>
    <div class="relative mx-auto max-w-4xl px-5 py-12 text-center">
      <div class="bg-card ring-foreground/10 mb-12 rounded-2xl p-8 ring-1">
        <h2
          class="mb-6 flex items-center justify-center gap-3 text-3xl font-semibold"
        >
          <Sparkles className="text-primary size-7" strokeWidth={1.75} />
          What's Coming Next
        </h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div
            class="ring-foreground/10 rounded-xl bg-black/20 p-6 text-left ring-1"
          >
            <FolderPlus
              className="text-primary mb-3 size-7"
              strokeWidth={1.75}
            />
            <h3 class="mb-2 text-lg font-semibold">Import Custom Sounds</h3>
            <p class="text-gray-200">
              Add your own audio files to create truly personalized soundscapes.
            </p>
          </div>
          <div
            class="ring-foreground/10 rounded-xl bg-black/20 p-6 text-left ring-1"
          >
            <Smartphone
              className="text-primary mb-3 size-7"
              strokeWidth={1.75}
            />
            <h3 class="mb-2 text-lg font-semibold">iOS & iPadOS</h3>
            <p class="text-gray-200">
              Bring your favorite ambient sounds to iPhone and iPad.
            </p>
          </div>
        </div>
        <p class="mt-6 text-gray-400">
          Have feature requests? <a
            href="/contributing/"
            class="text-yellow-400 underline transition-colors hover:text-yellow-300"
            >Let us know!</a
          >
        </p>
      </div>

      <!-- CTA -->
      <div class="text-center">
        <h2 class="mb-4 text-2xl font-semibold">
          Ready to experience Blankie?
        </h2>
        <a
          href="/#download"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center rounded-md px-6 py-3 text-lg font-semibold transition-colors duration-200"
        >
          Download Now
        </a>
      </div>
    </div>
  </section>
</Layout>
