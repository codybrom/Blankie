  <script>
    // Hovering or focusing a parody app highlights the lines that apply to it.
    const parodyApps = document.querySelectorAll<HTMLElement>(".parody-app");
    const parodyLimits = document.querySelectorAll<HTMLElement>(".parody-limit");
    const showParody = (id: string | null) => {
      parodyApps.forEach((el) => el.classList.toggle("is-dim", !!id && el.dataset.app !== id));
      parodyLimits.forEach((el) => {
        const hit = !!id && (el.dataset.apps ?? "").split(" ").includes(id);
        el.classList.toggle("is-hit", hit);
        el.classList.toggle("is-dim", !!id && !hit);
      });
    };
    parodyApps.forEach((el) => {
      el.addEventListener("pointerenter", () => showParody(el.dataset.app ?? null));
      el.addEventListener("focus", () => showParody(el.dataset.app ?? null));
      el.addEventListener("pointerleave", () => showParody(null));
      el.addEventListener("blur", () => showParody(null));
    });
  </script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // Brew copy-to-clipboard
      const brew = document.getElementById("brew-copy-button");
      const copyIcon = document.getElementById("brew-copy-icon");
      const checkIcon = document.getElementById("brew-check-icon");
      if (brew && copyIcon && checkIcon) {
        let resetTimer: ReturnType<typeof setTimeout> | undefined;
        brew.addEventListener("click", () => {
          navigator.clipboard.writeText("brew install --cask blankie");
          copyIcon.classList.add("hidden");
          checkIcon.classList.remove("hidden");
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => {
            checkIcon.classList.add("hidden");
            copyIcon.classList.remove("hidden");
          }, 1500);
        });
      }

      // Homebrew modal
      const brewModal = document.getElementById("brew-modal");
      if (brewModal instanceof HTMLDialogElement) {
        document
          .getElementById("brew-open")
          ?.addEventListener("click", () => brewModal.showModal());
        document
          .getElementById("brew-close")
          ?.addEventListener("click", () => brewModal.close());
        brewModal.addEventListener("click", (e) => {
          if (e.target === brewModal) brewModal.close();
        });
      }

      // Floating section nav: highlight the link for the section in view.
      const links = document.querySelectorAll<HTMLAnchorElement>(".section-pill a[data-section]");
      const byId = new Map<string, HTMLAnchorElement>();
      links.forEach((l) => byId.set(l.dataset.section || "", l));
      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              links.forEach((l) => l.classList.remove("active"));
              byId.get(e.target.id)?.classList.add("active");
            }
          });
        },
        { rootMargin: "-45% 0px -45% 0px" },
      );
      ["devices", "features", "reviews", "download"].forEach((id) => {
        const el = document.getElementById(id);
        if (el) spy.observe(el);
      });

      // Fade the floating nav out once the download section is reached, and
      // keep it hidden all the way down (it returns if you scroll back up).
      const pill = document.querySelector<HTMLElement>(".section-pill");
      const downloadEl = document.getElementById("download");
      if (pill && downloadEl) {
        let queued = false;
        const update = () => {
          queued = false;
          const top = downloadEl.getBoundingClientRect().top;
          pill.classList.toggle("is-hidden", top < window.innerHeight * 0.85);
        };
        const onScroll = () => {
          if (!queued) {
            queued = true;
            requestAnimationFrame(update);
          }
        };
        update();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
      }

    });
  </script>

