---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { Card } from "@/components/ui/card";
import BackgroundVideo from "../components/BackgroundVideo.astro";
import screenshot from "../assets/en-dark.png";
import macAppStoreBadge from "../assets/download-on-mac-app-store.svg";
import wavesVideo from "../assets/waves.mp4";
import wavesPoster from "../assets/waves-poster.jpg";
import ghSVG from "../assets/github.svg";
import bmcSVG from "../assets/bmc.svg";
import kfSVG from "../assets/kofi.svg";
import laurelLeft from "../assets/laurel-left.svg";
import laurelRight from "../assets/laurel-right.svg";
import {
  Globe,
  ChevronRight,
  SlidersHorizontal,
  Bookmark,
  Languages,
  Infinity as InfinityIcon,
  FolderPlus,
  FlaskConical,
} from "lucide-react";

const title = "Ambient sound mixer for macOS";
---

<Layout title={title}>
  <!-- Hero Section -->
  <section
    class="relative flex min-h-screen items-center justify-center overflow-hidden bg-black text-white"
  >
    <BackgroundVideo videoSrc={wavesVideo} posterSrc={wavesPoster.src} />
    <div class="relative z-10 mx-auto mt-8 max-w-4xl px-5 py-16 text-center">
      <a
        href="/i18n/"
        class="group bg-card ring-foreground/10 hover:ring-foreground/25 mt-6 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm font-medium tracking-wide text-gray-200 no-underline ring-1 transition-colors"
      >
        <Globe className="text-primary size-4 shrink-0" strokeWidth={1.75} />
        Now available in Deutsch, Español, Français, Italiano, Magyar, Polski, 日本語,
        한국어, Português, Türkçe and 简体中文!
        <span
          class="shrink-0 text-gray-400 transition-transform group-hover:translate-x-0.5"
          aria-hidden="true">→</span
        >
      </a>

      <h1
        class="my-4 text-5xl/tight font-semibold tracking-tighter md:text-6xl"
      >
        Ambient sounds&nbsp;for your&nbsp;flow&nbsp;state.
      </h1>
      <h2 class="mb-6 text-2xl/normal font-normal tracking-tight md:text-3xl">
        <div class="flex flex-row justify-center space-x-2">
          <span class="hidden sm:inline">Focus better.</span>
          <span class="hidden sm:inline">Work smarter.</span>
          <span class="hidden sm:inline">Rest deeper.</span>

          <span class="sm:hidden">Rest.</span>
          <span class="sm:hidden">Focus.</span>
          <span class="sm:hidden">Flow.</span>
        </div>
      </h2>

      <a href="/features/" class="block">
        <Image
          src={screenshot}
          alt="Screenshot of the Blankie app"
          widths={[375, 750, 800, 1600]}
          sizes="(max-width: 768px) 100vw, 800px"
          width={800}
          height={454}
          loading="eager"
          class="mx-auto my-12 block w-full max-w-full cursor-pointer rounded-lg ring-1 ring-white/10 transition duration-300 hover:scale-[1.02] hover:ring-white/20 md:w-200"
          quality={90}
        />
      </a>

      <!-- Social Proof Section -->
      <div class="mb-8 flex flex-col items-center gap-4">
        <!-- Featured Badges Row -->
        <div class="flex flex-wrap justify-center gap-4">
          <!-- Mac App Store Featured Badge -->
          <a
            href="https://apps.apple.com/app/blankie/id6740096581"
            target="_blank"
            class="bg-card ring-foreground/10 hover:ring-foreground/25 relative inline-flex items-center gap-2 rounded-full px-6 py-3 ring-1 transition-colors duration-200"
          >
            <!-- Left Laurel -->
            <img
              src={laurelLeft.src}
              alt=""
              width="25"
              height="50"
              class="inline-block"
              style="filter: invert(84%) sepia(28%) saturate(668%) hue-rotate(345deg) brightness(91%) contrast(88%); opacity: 0.7;"
            />
            <div class="px-2 text-center">
              <div
                class="text-xs font-bold tracking-wider text-yellow-500 uppercase"
              >
                Mac App Store
              </div>
              <div class="text-sm font-semibold text-gray-200 italic">
                Best New Apps and Updates
              </div>
              <div class="text-xs text-gray-400">United States • May 2025</div>
            </div>
            <!-- Right Laurel -->
            <img
              src={laurelRight.src}
              alt=""
              width="25"
              height="50"
              class="inline-block"
              style="filter: invert(84%) sepia(28%) saturate(668%) hue-rotate(345deg) brightness(91%) contrast(88%); opacity: 0.7;"
            />
          </a>

          <!-- Product Hunt Featured Badge -->
          <a
            href="https://www.producthunt.com/products/blankie?embed=true&utm_source=badge-top-post-topic-badge&utm_medium=badge&utm_source=badge-blankie"
            target="_blank"
            class="bg-card ring-foreground/10 hover:ring-foreground/25 inline-flex items-center rounded-full px-6 py-3 ring-1 transition-colors duration-200"
          >
            <div class="text-center">
              <div
                class="text-xs font-bold tracking-wider text-orange-500 uppercase"
              >
                Product Hunt
              </div>
              <div class="text-sm font-semibold text-gray-200 italic">
                #4 Product of the Month
              </div>
              <div class="text-xs text-gray-400">
                Health and Fitness • May 2025
              </div>
            </div>
          </a>
        </div>

        <!-- Stats Row -->
        <div class="flex flex-wrap justify-center gap-4">
          <!-- Combined Stats Box -->
          <div
            class="bg-card ring-foreground/10 inline-flex items-center gap-6 rounded-full px-8 py-3 ring-1"
          >
            <!-- Rating -->
            <div class="flex items-center gap-2">
              <svg
                class="size-5 text-yellow-500"
                fill="currentColor"
                viewBox="0 0 20 20"
                aria-hidden="true"
              >
                <path
                  d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                ></path>
              </svg>
              <span class="font-semibold text-gray-100">4.9</span>
              <span class="text-gray-400">Global App Store Rating</span>
            </div>
            <!-- Divider -->
            <div class="h-6 w-px bg-zinc-700"></div>
            <!-- Downloads -->
            <div class="flex items-center gap-2">
              <svg
                class="text-primary-blue size-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                ></path>
              </svg>
              <span class="font-semibold text-gray-100">10,000+</span>
              <span class="text-gray-400">Downloads</span>
            </div>
          </div>
        </div>
      </div>

      <div
        id="download"
        class="mx-auto mt-4 flex max-w-fit flex-col items-center gap-y-4"
      >
        <!-- Primary Download -->
        <div class="flex flex-col items-center">
          <a
            href="https://apps.apple.com/app/blankie/id6740096581"
            class="transition-all duration-300 hover:opacity-90"
          >
            <img
              src={macAppStoreBadge.src}
              alt="Download on the Mac App Store"
              width="240"
              height="80"
              loading="lazy"
              class="select-none"
              style="user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;"
            />
          </a>
          <span class="mt-2 text-xs font-bold text-gray-200"
            >Recommended Method • Automatic Updates</span
          >
        </div>

        <!-- Alternative Options -->
        <div class="flex flex-col items-center gap-2 text-sm">
          <div class="flex flex-col items-center gap-1 sm:flex-row sm:gap-3">
            <a
              href="https://github.com/codybrom/blankie/releases/latest/download/Blankie.zip"
              class="text-yellow-300 underline transition-colors hover:text-yellow-200"
            >
              Direct Download
            </a>
            <span class="hidden text-gray-400 sm:inline">•</span>
            <a
              href="#brew"
              class="text-yellow-300 underline transition-colors hover:text-yellow-200"
            >
              Install via Homebrew
            </a>
          </div>
          <span class="text-center text-xs text-gray-400">
            Verified by Apple • Manual Updates Only</span
          >
        </div>
      </div>
      <p
        class="mt-12 flex flex-col items-center justify-center gap-2 text-lg text-gray-100 sm:flex-row sm:gap-2"
      >
        <span>macOS 14.6+</span>
        <span class="hidden text-gray-400 sm:inline">•</span>
        <span class="sm:ml-2">No Ads or Subscriptions</span>
        <span class="hidden text-gray-400 sm:inline">•</span>
        <span class="sm:ml-2">Offline & Private</span>
        <span class="hidden text-gray-400 sm:inline">•</span>
        <a
          href="/contributing/"
          class="transition-colors duration-300 hover:text-yellow-500 sm:ml-2"
        >
          Open Source
        </a>
      </p>
    </div>
  </section>

  <!-- Features Section -->
  <section class="mx-auto max-w-5xl px-5 py-10" id="features">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      <a
        href="/features/#high-quality-audio"
        class="group bg-card ring-foreground/10 hover:ring-foreground/25 block rounded-xl p-8 ring-1 transition duration-200"
      >
        <SlidersHorizontal className="text-primary size-7" strokeWidth={1.75} />
        <h3
          class="mt-5 mb-2 flex items-center gap-2 text-xl font-semibold transition-colors group-hover:text-yellow-300"
        >
          High-Quality Audio
          <ChevronRight
            className="size-4 opacity-60 transition-opacity group-hover:opacity-100"
            strokeWidth={2}
          />
        </h3>
        <p class="text-mid-gray">
          14 built-in ambient sounds for mixing custom soundscapes.
        </p>
        <p
          class="mt-2 text-xs text-yellow-300 opacity-0 transition-opacity group-hover:opacity-100"
        >
          Learn more about audio features →
        </p>
      </a>

      <a
        href="/features/#preset-perfection"
        class="group bg-card ring-foreground/10 hover:ring-foreground/25 block rounded-xl p-8 ring-1 transition duration-200"
      >
        <Bookmark className="text-primary size-7" strokeWidth={1.75} />
        <h3
          class="mt-5 mb-2 flex items-center gap-2 text-xl font-semibold transition-colors group-hover:text-yellow-300"
        >
          Preset Perfection
          <ChevronRight
            className="size-4 opacity-60 transition-opacity group-hover:opacity-100"
            strokeWidth={2}
          />
        </h3>
        <p class="text-mid-gray">
          Save and switch between your favorite ambient mixes.
        </p>
        <p
          class="mt-2 text-xs text-yellow-300 opacity-0 transition-opacity group-hover:opacity-100"
        >
          Learn more about presets →
        </p>
      </a>

      <a
        href="/i18n/"
        class="group bg-card ring-foreground/10 hover:ring-foreground/25 block rounded-xl p-8 ring-1 transition duration-200"
      >
        <Languages className="text-primary size-7" strokeWidth={1.75} />
        <h3
          class="mt-5 mb-2 flex items-center gap-2 text-xl font-semibold transition-colors group-hover:text-yellow-300"
        >
          Multiple Languages
          <ChevronRight
            className="size-4 opacity-60 transition-opacity group-hover:opacity-100"
            strokeWidth={2}
          />
        </h3>
        <p class="text-mid-gray">
          Available in 10+ languages with ongoing community contributions.
        </p>
        <p
          class="mt-2 text-xs text-yellow-300 opacity-0 transition-opacity group-hover:opacity-100"
        >
          View translations page →
        </p>
      </a>

      <a
        href="/features/#made-for-macos"
        class="group bg-card ring-foreground/10 hover:ring-foreground/25 block rounded-xl p-8 ring-1 transition duration-200"
      >
        <span
          class="text-primary block text-3xl leading-none"
          aria-hidden="true"></span
        >
        <h3
          class="mt-5 mb-2 flex items-center gap-2 text-xl font-semibold transition-colors group-hover:text-yellow-300"
        >
          Made for macOS
          <ChevronRight
            className="size-4 opacity-60 transition-opacity group-hover:opacity-100"
            strokeWidth={2}
          />
        </h3>
        <p class="text-mid-gray">
          <i class="font-semibold">It just works</i> with media keys, Control Center
          & AirPod controls.
        </p>
        <p
          class="mt-2 text-xs text-yellow-300 opacity-0 transition-opacity group-hover:opacity-100"
        >
          Learn more about features →
        </p>
      </a>
      <a
        href="/privacy/"
        class="group bg-card ring-foreground/10 hover:ring-foreground/25 block rounded-xl p-8 ring-1 transition duration-200"
      >
        <InfinityIcon className="text-primary size-7" strokeWidth={1.75} />
        <h3
          class="mt-5 mb-2 flex items-center gap-2 text-xl font-semibold transition-colors group-hover:text-yellow-300"
        >
          Actually Free
          <ChevronRight
            className="size-4 opacity-60 transition-opacity group-hover:opacity-100"
            strokeWidth={2}
          />
        </h3>
        <p class="text-mid-gray">
          No accounts, subscriptions, or additional purchases. Ever.
        </p>
        <p
          class="mt-2 text-xs text-yellow-300 opacity-0 transition-opacity group-hover:opacity-100"
        >
          View privacy policy →
        </p>
      </a>

      <div
        class="bg-card ring-foreground/10 relative rounded-xl p-8 opacity-80 ring-1"
      >
        <span
          class="bg-secondary text-secondary-foreground absolute top-4 right-4 inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium"
        >
          Coming Soon
        </span>
        <FolderPlus className="text-mid-gray size-7" strokeWidth={1.75} />
        <h3 class="mt-5 mb-2 text-xl font-semibold">Custom Sounds</h3>
        <p class="text-mid-gray">
          Soon, you'll be able to add your own sounds for a truly custom mix.
        </p>
      </div>
    </div>
  </section>

  <!-- Homebrew Installation Section -->
  <section class="mx-auto max-w-3xl px-5 py-4 text-center" id="brew">
    <h2 class="mb-6 text-3xl font-semibold">Install with Homebrew</h2>
    <Card className="mb-6 gap-0 p-8">
      <p class="mb-4">
        You can install Blankie via Homebrew by running this in your Terminal:
      </p>
      <div
        class="group relative cursor-pointer overflow-x-auto rounded-md bg-black px-4 py-3 text-center text-white transition-colors duration-200 hover:bg-neutral-900"
        id="brew-command-container"
      >
        <pre
          class="m-0"><code class="inline-block">brew install --cask blankie</code></pre>

        <!-- Hover overlay -->
        <div
          class="pointer-events-none absolute inset-0 flex items-center justify-center rounded-md bg-black/70 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
        >
          <span class="text-sm text-white">Click to copy to clipboard</span>
        </div>

        <!-- Success message -->
        <div
          id="copy-success-message"
          class="pointer-events-none absolute inset-0 flex items-center justify-center rounded-md bg-black/80 opacity-0 transition-opacity duration-300"
        >
          <span class="text-sm text-white">Copied to clipboard!</span>
        </div>
      </div>
      <p class="text-mid-gray mt-4">
        Requires Homebrew to be installed on your Mac. Visit <a
          href="https://formulae.brew.sh/cask/blankie"
          class="text-yellow-400 underline transition-colors hover:text-yellow-300"
          >brew.sh</a
        > for more information.
      </p>
    </Card>
  </section>

  <!-- Coming Soon Section -->
  <section class="mx-auto max-w-3xl px-5 py-4 text-center">
    <div class="bg-card ring-foreground/10 mb-6 rounded-xl p-8 ring-1">
      <div class="mb-4 flex items-center justify-center">
        <h2 class="text-2xl font-semibold">
          Wish you could use Blankie on other devices?
        </h2>
      </div>
      <p class="mb-6">
        Blankie is coming to iOS, iPadOS, and visionOS. If you don't mind things
        being a little rough around the edges, join Blankie's beta crew and help
        us test it out!
      </p>
      <a
        href="https://testflight.apple.com/join/XgpBpWv8"
        class="bg-secondary text-foreground ring-border hover:bg-secondary/80 inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm font-medium ring-1 transition-colors duration-200"
        target="_blank"
        rel="noopener noreferrer"
      >
        <FlaskConical className="size-4" strokeWidth={1.75} />
        Join the TestFlight Beta
      </a>
      <p class="mt-4 text-xs text-white">
        Requires TestFlight to be installed on your device.
        <a
          href="https://developer.apple.com/testflight/"
          class="text-yellow-400 underline transition-colors hover:text-yellow-300"
          >Learn more about TestFlight</a
        >
      </p>
    </div>
  </section>

  <!-- Support Section -->
  <section class="mx-auto my-4 max-w-3xl px-5 py-10 text-center">
    <h2 class="mb-2 text-xl font-semibold">
      Blankie is made with love and caffeine
    </h2>
    <p class="mb-6 text-sm text-gray-100">
      If you enjoy using it and want to support its creator and development, you
      can use the links below:
    </p>
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="https://github.com/sponsors/codybrom"
        class="text-foreground bg-secondary ring-border hover:bg-secondary/80 inline-flex items-center rounded-md px-4 py-2 text-sm font-medium ring-1 transition-colors duration-200"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          class="mr-2 inline-block h-3.75"
          src={ghSVG.src}
          alt=""
          width="15"
          height="15"
        />
        GitHub Sponsors
      </a>
      <a
        href="https://buymeacoffee.com/codybrom"
        class="text-foreground bg-secondary ring-border hover:bg-secondary/80 inline-flex items-center rounded-md px-4 py-2 text-sm font-medium ring-1 transition-colors duration-200"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          class="mr-2 inline-block h-3.75"
          src={bmcSVG.src}
          alt=""
          width="15"
          height="15"
        />
        Buy Me a Coffee
      </a>
      <a
        href="https://ko-fi.com/codybrom"
        class="text-foreground bg-secondary ring-border hover:bg-secondary/80 inline-flex items-center rounded-md px-4 py-2 text-sm font-medium ring-1 transition-colors duration-200"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          class="mr-2 inline-block h-3.75"
          src={kfSVG.src}
          alt=""
          width="15"
          height="15"
        />
        Ko-fi
      </a>
    </div>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const brewCommandContainer = document.getElementById(
        "brew-command-container",
      );
      const successMessage = document.getElementById("copy-success-message");

      if (brewCommandContainer && successMessage) {
        brewCommandContainer.addEventListener("click", () => {
          navigator.clipboard.writeText("brew install --cask blankie");

          // Show the success message
          successMessage.style.opacity = "1";

          // Hide it after a delay
          setTimeout(() => {
            successMessage.style.opacity = "0";
          }, 1500);
        });
      }
    });
  </script>
</Layout>
