---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import BackgroundVideo from "../components/BackgroundVideo.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import icon from "../assets/blankie-icon-v2.png";
import wavesVideo from "../assets/waves.mp4";
import wavesVideoMobile from "../assets/waves-mobile.mp4";
import wavesPoster from "../assets/waves-poster.jpg";
import laurelLeft from "../assets/laurel-left.svg";
import laurelRight from "../assets/laurel-right.svg";
import appStoreBadge from "../assets/app-store-badge.svg";
// Real 2.0 navy product shots.
import heroDevices from "../assets/hero-devices.png";
import macWindow from "../assets/mac-window-v2.png";
import ipadShot from "../assets/ipad-landscape.png";
import ipadPreset from "../assets/ipad-preset.png";
import iphoneTimer from "../assets/iphone-timer.png";
import iphoneLock from "../assets/iphone-animatedlock.png";
import macCustomize from "../assets/mac-customize.png";
import macMenubar from "../assets/mac-menubar.png";
import carplayShot from "../assets/carplay-mockup.jpg";
import duoSeated from "../assets/guides/blankie-iphone-duo/seated.png";
import duoBook from "../assets/guides/blankie-iphone-duo/book.png";
import parodyClam from "../assets/parody/clam.svg";
import parodyWorseSleep from "../assets/parody/worse-sleep.svg";
import parodySpendel from "../assets/parody/spendel.svg";
import parodyDarkPattern from "../assets/parody/dark-pattern.svg";
import parodyNosey from "../assets/parody/nosey.svg";
import parodyAdNoiseLite from "../assets/parody/ad-noise-lite.svg";
import bg1 from "../assets/bg-1.png";
import bg2 from "../assets/bg-2.png";
import bg3 from "../assets/bg-3.png";
import bg4 from "../assets/bg-4.png";
import {
  Smartphone,
  Monitor,
  Tablet,
  BookOpen,
  AudioLines,
  FolderPlus,
  CloudRain,
  Waves,
  Flame,
  Image as ImageIcon,
  Car,
  Sparkles,
  Palette,
  Orbit,
  SlidersHorizontal,
  GitBranch,
  Check,
  X,
  Star,
  Lock,
  Languages,
  ArrowRight,
  Moon,
  Timer,
  Download,
  Eye,
  Terminal,
  MessageSquareText,
} from "lucide-react";
import { softwareAppLd, ldGraph } from "@/utils/schema";
import { getTestimonial } from "@/utils/testimonials";

const title = "Ambient sounds for sleep and focus";
const appStore =
  "https://apps.apple.com/us/app/blankie/id6740096581?itscg=30200&itsct=apps_box_badge&mttnsubad=6740096581";

// Structured data: the launched, free, multi-platform app and its App Store rating.
const appJsonLd = ldGraph(softwareAppLd({ withRating: true }));

// Award row, each stat flanked by laurel branches. Middle is the marquee.
const awards = [
  { title: "4.9 out of 5.0", sub: "Global App Store rating", large: false },
  { title: 'Best New Apps & Updates', sub: "App Store · May 2025", large: true },
  {
    title: "#4 Product of the Month",
    sub: "Product Hunt • Health & Fitness • May 2025",
    large: false,
  },
];


// Alternating feature sections (kept from the current homepage), restyled navy.
const features = [
  {
    eyebrow: "Mix",
    heading: "Layer as many sounds as you like.",
    blurb:
      "Blankie comes with 24 built-in sounds, from steady rain and bedroom fans to coffee shops and brown noise. Start with one, layer in another and balance each volume until the mix feels right.",
    screen: macWindow,
    screenAlt: "Blankie on Mac with several ambient sounds playing at once",
    portrait: false,
    bg: bg1,
    points: [
      {
        icon: AudioLines,
        title: "Individually adjustable volumes",
        sub: "Every sound has its own slider so you can set each one as loud or quiet as you want.",
      },
      {
        icon: FolderPlus,
        title: "Bring your own sounds",
        sub: "Import your own audio files and mix them alongside the built-in library.",
      },
    ],
  },  
  {
    eyebrow: "Sleep timer",
    heading: "Fall asleep without playing all night.",
    blurb:
      "Set a timer when you get into bed and Blankie will gently fade your mix out on its own, or let it loop seamlessly until morning.",
    screen: iphoneTimer,
    screenAlt: "Blankie's sleep timer on iPhone over warm artwork",
    portrait: true,
    bg: bg1,
    points: [
      {
        icon: Timer,
        title: "Soft fade-out at bedtime",
        sub: "Your mix eases down gradually at the end of the timer so a sudden silence never wakes you up.",
      },
      {
        icon: Moon,
        title: "Seamless all-night loops",
        sub: "Want your sounds to run until your alarm? Every built-in loop is cut to play all night without an audible seam.",
      },
    ],
  },
  {
    eyebrow: "Presets",
    heading: "Save your mixes for sleep and work.",
    blurb:
      "Keep separate presets for falling asleep, winding down or tuning out a noisy room while you focus. Star your favorites to keep them one tap away.",
    screen: ipadPreset,
    screenAlt: "Blankie on iPad with a saved preset and its mix",
    portrait: false,
    bg: bg2,
    points: [
      { icon: CloudRain, title: "Heavy Rain Sleep", sub: "Rain + Brown Noise + Fan" },
      { icon: Flame, title: "Cozy Night In", sub: "Fireplace + Wind + Warm Piano" },
      { icon: Waves, title: "Ocean Focus", sub: "Green Noise + Waves + Lo-Fi Beats" },
    ],
  },
  {
    eyebrow: "Customize",
    heading: "Make it unmistakably yours.",
    blurb:
      "Give each preset its own background photo and accent color so your mixes look the part day or night.",
    screen: macCustomize,
    screenAlt: "Blankie's preset editor with a free-form accent color picker",
    portrait: false,
    bg: bg2,
    points: [
      {
        icon: Palette,
        title: "Customize colors",
        sub: "Set a unique accent color for each preset.",
      },
      {
        icon: ImageIcon,
        title: "Customize artwork",
        sub: "Choose background photos and Lock Screen animations for each mix.",
      },
    ],
  },
];

// "One Blankie, every screen": a device card per surface, with a real shot.
const devices = [
  {
    icon: Smartphone,
    name: "iPhone",
    heading: "Ready on your nightstand",
    sub: "Start your bedtime preset from a Home Screen widget or Siri, set a sleep timer and give your Lock Screen a looping video backdrop while you wind down.",
    img: iphoneLock,
    alt: "Blankie playing on the iPhone Lock Screen over animated rain artwork",
    portrait: true,
  },
  {
    icon: Monitor,
    name: "Mac",
    heading: "Mix from your menu bar",
    sub: "Start, stop and adjust your mixes right from the Mac menu bar while you read, work or wind down. You can also hide the Dock icon and run Blankie in the background.",
    img: macMenubar,
    alt: "Blankie's menu bar mixer popover on Mac",
  },
  {
    icon: Tablet,
    name: "iPad",
    heading: "Sidebar and mixer, side by side",
    sub: "Your favorite presets and Quick Mix on the left, all your sound tiles and the sleep timer on the right.",
    img: ipadShot,
    alt: "Blankie on iPad",
  },
  {
    icon: Car,
    name: "CarPlay",
    heading: "Calm drives and naptime rides",
    sub: "Put rain, white noise or your favorite presets on the dashboard for late-night drives or a sleeping kid in the back seat.",
    img: carplayShot,
    alt: "Blankie on CarPlay in a car dashboard",
  },
];

// Additional features, as a card grid.
const moreFeatures = [
  {
    icon: Languages,
    title: "Localized in 12 languages",
    sub: "Blankie is available in 12 languages, with more added all the time by community translators.",
  },  
    {
    icon: SlidersHorizontal,
    title: "Control it everywhere",
    sub: "Use Home Screen widgets, Siri, Shortcuts or find presets and sounds in Spotlight. Control Center, headphones and media keys work too.",
  },
    {
    icon: Lock,
    title: "Offline & private by design",
    sub: "Works fully offline and collects nothing about you. No ads, no subscriptions, no accounts, no tracking.",
  },
{
    icon: Sparkles,
    title: "Apple Intelligence",
    tag: "Where available",
    sub: "Blankie can suggest names and icons using the on-device AI model.",
  },
  {
    icon: Orbit,
    title: "Spatial Audio",
    tag: "Experimental",
    sub: "Place a preset's sounds around you on a draggable map, rendered binaurally on any headphones.",
  },
  {
    icon: GitBranch,
    title: "Open Source",
    sub: "Blankie is developed openly on GitHub and welcomes contributions from the community.",
  },
];

const homeReviewIds = [
  "no-paywall-sleep",
  "mix-five-sounds",
  "nightly-mixes",
  "straightforward",
  "carplay-standout",
  "free-quality",
  "youtube-tabs",
  "custom-soundscapes",
  "pencil-neighbor",
];

const homeReviews = homeReviewIds.map((id) => getTestimonial(id));

const blankieIncluded = [
  {
    title: "All 24 built-in sounds",
    sub: "Including rain, waves, fireplace, noise colors and music loops",
  },
  {
    title: "Unlimited adjustable layers",
    sub: "Mix as many sounds together as you like, each with its own volume",
  },
  {
    title: "Import your own audio",
    sub: "Automatically loudness-matched so nothing ruins the mix",
  },
  {
    title: "CarPlay & iPhone Duo support",
    sub: "Ready for your dashboard on the road and your nightstand at home",
  },
  {
    title: "Widgets, Siri & Shortcuts",
    sub: "Home Screen controls, Action Button and Focus automations",
  },
  {
    title: "Sleep timer & Lock Screen art",
    sub: "Gradual fade-out and looping video backdrops",
  },
  {
    title: "Shareable presets",
    sub: "Send custom mixes to friends as .blankie files with no accounts needed",
  },
  {
    title: "100% offline & private",
    sub: "Plays without an internet connection and collects no analytics",
  },
  {
    title: "Translated into 12 languages",
    sub: "Built with volunteer translators around the world",
  },
  {
    title: "Every update, free",
    sub: "No Pro tier, no upgrade screen, no unlocks to buy later",
  },
];

// Parody app icons (src/assets/parody/) stand in for real apps
const parodyApps = [
  { id: "clam", name: "Clam", src: parodyClam, badges: [{ kind: "price", label: "$$" }, { kind: "tracking", label: "" }] },
  { id: "worse-sleep", name: "Worse Sleep", src: parodyWorseSleep, badges: [{ kind: "price", label: "$$" }, { kind: "tracking", label: "" }] },
  { id: "spendel", name: "Spendel", src: parodySpendel, badges: [{ kind: "price", label: "$$$" }, { kind: "tracking", label: "" }] },
  { id: "dark-pattern", name: "Dark Pattern", src: parodyDarkPattern, badges: [{ kind: "price", label: "$" }] },
  { id: "nosey", name: "Nosey", src: parodyNosey, badges: [{ kind: "tracking", label: "" }] },
  { id: "ad-noise-lite", name: "Ad Noise Lite", src: parodyAdNoiseLite, badges: [{ kind: "tracking", label: "" }] },
];
// Corner badges on the parody icons: a $ scale for yearly price ($ under $40,
// $$ under $100, $$$ above) and an eye for tracking, from each app's own App
// Store privacy label or privacy policy.
const badgeStyles: Record<string, string> = {
  price: "bg-red-500 text-white",
  tracking: "bg-violet-500 text-white",
};
// Each line is generic (true of at least two of the apps) and lists the parody
// apps it applies to. Every claim comes from the apps' own App Store listings,
// privacy labels and privacy policies, checked Oct. 2026.
const typicalAppLimits = [
  {
    text: "Limit what you can listen to or do until you pay",
    apps: ["clam", "worse-sleep", "spendel", "dark-pattern", "nosey", "ad-noise-lite"],
  },
  // Usage analytics: every app's label or policy lists it.
  {
    text: "Can monitor how you use the app",
    apps: ["clam", "worse-sleep", "spendel", "dark-pattern", "nosey", "ad-noise-lite"],
  },
  {
    text: "Can track your location",
    apps: ["worse-sleep", "spendel", "ad-noise-lite"],
  },
  {
    text: "Can track you across other apps and the web",
    apps: ["clam", "worse-sleep", "spendel", "nosey", "ad-noise-lite"],
  },
  {
    text: "Have free trials that start charging you automatically",
    apps: ["clam", "worse-sleep", "spendel", "dark-pattern"],
  },
  {
    text: "Don't have a CarPlay app",
    apps: ["clam", "worse-sleep", "spendel", "dark-pattern", "nosey", "ad-noise-lite"],
  },
  {
    text: "Collect your personal information",
    apps: ["clam", "worse-sleep", "spendel"],
  },
  {
    text: "Can share your data with third-party advertisers",
    apps: ["clam", "spendel", "nosey", "ad-noise-lite"],
  }

];
---

<Layout title={title}>
  <!-- Hero -->
  <section class="relative overflow-hidden text-center">
    <BackgroundVideo
      videoSrc={wavesVideo}
      mobileVideoSrc={wavesVideoMobile}
      posterSrc={wavesPoster.src}
    />
    <div
      class="from-navy-deep/80 via-navy-deep/70 to-navy-deep absolute inset-0 bg-linear-to-b"
    >
    </div>
    <div class="relative z-10 mx-auto flex max-w-5xl flex-col items-center px-5 pt-44 pb-20">
      <h1 class="mx-auto max-w-[14ch] text-4xl/[1.02] font-semibold tracking-tighter text-balance sm:text-6xl lg:text-7xl">
        Ambient sounds for <span class="grad-text">sleep and focus.</span>
      </h1>

      <p class="text-fg-2 mt-6 text-xl font-medium tracking-tight">
        Rest deeper at night. Stay focused during the day.
      </p>

      <!-- Real device family: iPad, Mac, iPhone, CarPlay and iPhone Duo -->
      <div class="mx-auto mt-12 w-full max-w-4xl">
        <Image
          src={heroDevices}
          alt="Blankie on iPad, Mac, iPhone, CarPlay and iPhone Duo"
          class="w-full"
          widths={[640, 896, 1792]}
          sizes="(min-width: 896px) 896px, 100vw"
          quality={90}
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="mt-10 flex justify-center">
        <a href={appStore} aria-label="Download Blankie on the App Store">
          <Image
            src={appStoreBadge}
            alt="Download on the App Store"
            class="h-14 w-auto"
            loading="eager"
          />
        </a>
      </div>

      <div class="mt-5 flex justify-center">
        <span class="bg-primary-blue inline-flex flex-wrap items-center justify-center gap-x-2.5 rounded-full px-6 py-3 text-center text-sm font-bold text-white shadow-[0_4px_12px_rgba(0,0,0,0.2)] sm:text-base">
          <span>All features 100% free.</span>
          <span>No ads or subscriptions.</span>
        </span>
      </div>

      <!-- Award row: a 3-col grid so the middle stat stays page-centered -->
      <div class="mt-12 grid grid-cols-1 items-center justify-items-center gap-x-6 gap-y-8 sm:grid-cols-[1fr_auto_1fr]">
        {
          awards.map((award) => (
            <div class="flex items-center gap-3.5">
              <Image
                src={laurelLeft}
                alt=""
                loading="lazy"
                width="18"
                height="44"
                class:list={["w-auto", award.large ? "h-16" : "h-12"]}
                style="filter: brightness(0) invert(0.72); opacity: 0.9;"
              />
              <div class="text-center">
                <div
                  class:list={[
                    "font-semibold text-gray-100",
                    award.large ? "text-xl sm:text-2xl" : "text-base",
                  ]}
                >
                  {award.title}
                </div>
                <div
                  class:list={["text-gray-400", award.large ? "text-sm" : "text-xs"]}
                >
                  {award.sub}
                </div>
              </div>
              <Image
                src={laurelRight}
                alt=""
                loading="lazy"
                width="18"
                height="44"
                class:list={["w-auto", award.large ? "h-16" : "h-12"]}
                style="filter: brightness(0) invert(0.72); opacity: 0.9;"
              />
            </div>
          ))
        }
      </div>

      <p class="mt-8 text-sm text-gray-400">
        Covered by ZDNET, 9to5Mac and Mac &amp; i.
        <a
          href="/press/"
          class="text-accent-ink ml-1 inline-flex items-center gap-1 font-semibold no-underline transition-colors hover:text-white"
        >
          <span>See the press page</span>
          <ArrowRight className="size-4" strokeWidth={2} />
        </a>
      </p>
    </div>
  </section>

  <!-- A Blankie for every screen -->
  <section class="relative overflow-hidden border-b border-white/5" id="devices">
    <div class="absolute inset-0">
      <Image src={bg4} alt="" class="size-full object-cover opacity-50" />
      <div class="bg-navy-deep/85 absolute inset-0"></div>
    </div>
    <div class="relative mx-auto max-w-6xl px-5 py-24">
      <div class="mb-12 max-w-2xl">
        <SectionHeader eyebrow="Every device" heading="A Blankie for every screen." />
      </div>
      <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-2">
        {
          devices.map((d) => (
            <div class="glass flex flex-col overflow-hidden rounded-2xl p-7">
              <div class="text-accent-ink flex items-center gap-2 text-sm font-semibold">
                <d.icon className="size-4" strokeWidth={1.75} />
                {d.name}
              </div>
              <h3 class="mt-2 text-xl font-semibold tracking-tight text-gray-100">
                {d.heading}
              </h3>
              <p class="text-fg-2 mt-2 text-sm">{d.sub}</p>
              <div
                class:list={[
                  "mt-6 flex grow justify-center",
                  d.portrait ? "-mb-7 items-end" : "items-end",
                ]}
              >
                <Image
                  src={d.img}
                  alt={d.alt}
                  class:list={[
                    d.portrait
                      ? "mx-auto w-auto max-w-64 translate-y-10"
                      : "w-full rounded-lg",
                  ]}
                  widths={d.portrait ? [256, 512] : [320, 540, 1080]}
                  sizes={
                    d.portrait
                      ? "256px"
                      : "(min-width: 1024px) 540px, (min-width: 640px) 90vw, 100vw"
                  }
                  quality={85}
                />
              </div>
            </div>
          ))
        }

        <!-- Full-width iPhone Duo showcase card -->
        <div class="glass overflow-hidden rounded-2xl p-7 lg:col-span-2 lg:p-9">
          <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[1fr_1.35fr]">
            <div>
              <div class="text-accent-ink flex flex-wrap items-center gap-2 text-sm font-semibold">
                <BookOpen className="size-4" strokeWidth={1.75} />
                <span>iPhone Duo</span>
                <span class="border-accent-ink/30 text-accent-ink rounded-full border px-2 py-0.5 text-[10px] font-semibold tracking-wide uppercase">
                  New in 2.1
                </span>
              </div>
              <h3 class="mt-2.5 text-2xl font-semibold tracking-tight text-gray-100">
                Built for every pose on iPhone Duo
              </h3>
              <p class="text-fg-2 mt-2.5 text-sm/relaxed">
                Set it down half-folded on your nightstand and the upright screen shows your artwork while the flat half keeps your sound tiles and sleep timer within reach. Unfold it like a book to put Now Playing on the left page and your Sound Mixer on the right.
              </p>
              <a
                href="/guides/blankie-iphone-duo/"
                class="text-accent-ink mt-5 inline-flex items-center gap-1.5 text-sm font-semibold no-underline transition-colors hover:text-white"
              >
                <span>See every posture</span>
                <ArrowRight className="size-4" strokeWidth={2} />
              </a>
            </div>
            <!-- Each figure grows by its image's aspect ratio, so both render at the same height. -->
            <div class="flex items-end gap-4">
              <figure class="min-w-0 text-center" style="flex: 863 1 0">
                <Image
                  src={duoSeated}
                  alt="Blankie on iPhone Duo in seated nightstand mode with artwork on the upright half and sound controls on the flat half"
                  loading="lazy"
                  class="w-full rounded-lg"
                />
                <figcaption class="text-fg-3 mt-2 text-xs">Seated mode</figcaption>
              </figure>
              <figure class="min-w-0 text-center" style="flex: 1246 1 0">
                <Image
                  src={duoBook}
                  alt="Blankie on iPhone Duo in book posture with Now Playing on the left page and the Sound Mixer on the right page"
                  loading="lazy"
                  class="w-full rounded-lg"
                />
                <figcaption class="text-fg-3 mt-2 text-xs">Book mode</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternating feature sections (kept) -->
  {
    [features.slice(0, 2), features.slice(2)].map((row, rowIndex) => (
      <section
        id={rowIndex === 0 ? "features" : undefined}
        class="relative overflow-hidden border-b border-white/5"
      >
        <div class="absolute inset-0">
          <Image src={row[0].bg} alt="" class="size-full object-cover opacity-60" />
          <div class="bg-navy-deep/85 absolute inset-0" />
        </div>
        <div class="relative mx-auto max-w-6xl space-y-20 px-5 py-20 lg:space-y-28 lg:py-24">
          {row.map((feature, j) => {
            const i = rowIndex * 2 + j;
            return (
              <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
                <div class={i % 2 === 1 ? "lg:order-2" : ""}>
                  <SectionHeader
                    eyebrow={feature.eyebrow}
                    heading={feature.heading}
                  />
                  <p class="text-fg-2 mt-4 text-lg">{feature.blurb}</p>
                  {feature.points && (
                    <ul class="mt-7 space-y-4">
                      {feature.points.map((point) => (
                        <li class="flex items-start gap-3">
                          <point.icon
                            className="text-accent-ink mt-0.5 size-5 shrink-0"
                            strokeWidth={1.75}
                          />
                          <div>
                            <div class="font-semibold text-gray-100">{point.title}</div>
                            <div class="text-fg-2 text-sm">{point.sub}</div>
                          </div>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                <div class={i % 2 === 1 ? "lg:order-1" : ""}>
                  <div class={feature.portrait ? "flex justify-center" : ""}>
                    <Image
                      src={feature.screen}
                      alt={feature.screenAlt}
                      class:list={[feature.portrait ? "w-auto max-w-72" : "w-full"]}
                      quality={90}
                    />
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ))
  }

  <!-- More features grid -->
  <section class="relative overflow-hidden border-b border-white/5">
    <div class="absolute inset-0">
      <Image src={bg3} alt="" class="size-full object-cover opacity-50" />
      <div class="bg-navy-deep/85 absolute inset-0"></div>
    </div>
    <div class="relative mx-auto max-w-5xl px-5 py-24">
      <div class="mb-12 max-w-2xl">
        <SectionHeader heading="And everything else you need to settle in." />
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          moreFeatures.map((f) => (
            <div class="glass rounded-2xl p-6">
              <div class="mb-4 grid size-10.5 place-items-center rounded-xl bg-[color-mix(in_srgb,var(--color-accent-blue)_20%,transparent)]">
                <f.icon className="text-accent-ink size-5" strokeWidth={1.75} />
              </div>
              <h3 class="text-lg font-semibold tracking-tight">
                {f.title}
                {f.tag && (
                  <span class="border-accent-ink/30 text-accent-ink ml-1.5 inline-block rounded-full border px-1.5 py-px align-middle text-[9px] font-semibold tracking-wide whitespace-nowrap uppercase">
                    {f.tag}
                  </span>
                )}
              </h3>
              <p class="text-fg-2 mt-2 text-sm">{f.sub}</p>
            </div>
          ))
        }
      </div>

      <div id="reviews" class="mt-24">
