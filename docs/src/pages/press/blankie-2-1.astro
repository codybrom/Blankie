---
import Layout from "../../layouts/Layout.astro";
import { ArrowLeft, Download, Images } from "@lucide/astro";
import { Image } from "astro:assets";
import Glow from "@/components/Glow.astro";
import Lightbox from "@/components/Lightbox.astro";
import eventArt from "../../assets/press/blankie-2-1-widgets-duo.jpg";
import widgetShot from "../../assets/guides/control-blankie-anywhere/iphone-quick-mix-widget.png";
import duoSeated from "../../assets/guides/blankie-iphone-duo/seated.png";
import duoBook from "../../assets/guides/blankie-iphone-duo/book.png";

const title = "Blankie 2.1 adds widgets, Siri, Shortcuts and iPhone Duo support";
const description =
  "Blankie 2.1 brings Home Screen widgets, Siri and Shortcuts actions, Spotlight search, a wider iPad layout and support for iPhone Duo to the free, open-source ambient sound mixer.";
---

<Layout
  title={title}
  description={description}
  image={eventArt}
  imageAlt="Paper-craft art of Blankie on iPhone Duo with its Home Screen widgets"
>
  <article>
    <header class="relative pt-33">
      <Glow
        class="-top-30 left-1/2 h-120 w-190 -translate-x-1/2"
        color="var(--color-b-yellow)"
        pct={7}
        fade={62}
      />
      <div class="relative z-10 mx-auto max-w-3xl px-5">
        <a
          class="inline-flex items-center gap-1.5 text-[13px] font-semibold tracking-[0.01em] text-fg-3 no-underline transition-colors hover:text-accent-ink"
          href="/press/"
        >
          <ArrowLeft size={14} stroke-width={2} /> Press kit
        </a>
        <div class="mt-7 text-xs font-bold tracking-[0.18em] text-warm uppercase">
          Press release · Oct. 28, 2026
        </div>
        <h1 class="mt-3.5 text-[clamp(34px,5vw,56px)] leading-[1.04] font-semibold tracking-tighter text-balance text-fg-1">
          Blankie 2.1 adds Home Screen widgets, Siri, Shortcuts and iPhone Duo support
        </h1>
        <p class="mt-5 max-w-[60ch] text-[clamp(18px,2.2vw,22px)] leading-normal text-fg-2">
          The free, open-source ambient sound mixer adds interactive widgets, Siri and Shortcuts actions, a wider iPad layout and full support for iPhone Duo.
        </p>
        <div class="mt-6 border-t border-hair-soft pt-5.5 text-[11.5px] font-semibold tracking-[0.08em] text-fg-3 uppercase">
          For immediate release
        </div>
      </div>
    </header>

    <div
      class="mx-auto max-w-3xl px-5 pt-9.5 pb-10 [&>p]:mb-5.5 [&>p]:text-[17.5px] [&>p]:leading-[1.74] [&>p]:text-[#d4d7ea] [&>p:first-of-type]:text-[19px] [&>p:first-of-type]:text-[#e6e8f2] [&_strong]:font-semibold [&_strong]:text-fg-1"
    >
      <figure class="mb-8">
        <a href={eventArt.src} data-zoom data-filename="blankie-2-1-widgets-duo.jpg" class="block cursor-zoom-in">
          <Image
            src={eventArt}
            alt="Paper-craft illustration of Blankie on iPhone Duo, opened like a book with Now Playing and sound tiles, next to the XL Quick Mix, Favorites and Now Playing widgets"
            widths={[720, 1200, 2400]}
            sizes="(min-width: 48rem) 45rem, 100vw"
            class="w-full rounded-2xl"
            loading="eager"
          />
        </a>
        <figcaption class="mt-1.5 text-right text-[11px] text-fg-3/60">Artwork by Cody Bromley</figcaption>
      </figure>

      <p>
        <span class="font-semibold text-fg-3">TULSA, Okla., Oct. 28, 2026:</span> Blankie
        2.1 is out today for iPhone, iPad and Mac. The update adds Home Screen widgets on iPhone and iPad, Siri and Shortcuts actions, Spotlight search and support for Apple's new iPhone Duo to the open-source ambient sound mixer. Like every previous release, Blankie 2.1 is completely free.
      </p>

      <p>
        On iPhone and iPad, listeners can add four interactive <strong>Home Screen widgets</strong>: Now Playing, Favorites, Pinned Sound and Quick Mix. Favorites and Quick Mix support custom widget colors and, on iOS 27, portrait XL sizes, including per-sound volume buttons inside the XL Quick Mix widget.
      </p>

      <figure class="mt-2 mb-7.5 text-center">
        <a href={widgetShot.src} data-zoom data-filename="blankie-quick-mix-widget.png" class="inline-block cursor-zoom-in">
          <Image
            src={widgetShot}
            alt="The XL Quick Mix widget on the iPhone Home Screen, with Rain and Fan turned on and minus and plus buttons beside every sound"
            widths={[400, 800]}
            sizes="18rem"
            class="mx-auto max-h-112 w-auto rounded-xl"
          />
        </a>
        <figcaption class="mt-2.5 text-sm text-fg-3">The XL Quick Mix widget on iOS 27</figcaption>
      </figure>

      <p>
        Blankie 2.1 also works with <strong>Siri, Shortcuts and Spotlight</strong>. On iPhone and iPad, users can ask Siri to start a saved preset, play a single sound or set a sleep timer. In the Shortcuts app on Mac, iPhone and iPad, new actions for playback, presets, individual sounds, sleep timers and volume let people build their own automations, like starting a rain mix and a 45-minute timer automatically when Sleep Focus turns on. Presets and sounds also show up in Spotlight search.
      </p>

      <p>
        On <strong>iPhone Duo</strong>, Blankie adapts to how you hold or set down the folding display. When iPhone Duo is held open like a book, Now Playing takes the left page and the Sound Mixer takes the right so the crease runs cleanly between them. When it's set down half-folded on a nightstand, the upright screen shows the preset's artwork and title while the flat half holds two rows of sound tiles and the playback bar. Users on iPad also get a wider two-column layout, and the Mac app now shows a preset's dimmed artwork behind the sound tiles.
      </p>

      <!-- Each image grows by its aspect ratio, so both render at the same height. -->
      <figure class="mt-2 mb-7.5">
        <div class="flex items-end gap-4">
          <a href={duoSeated.src} data-zoom data-filename="blankie-iphone-duo-seated.png" class="min-w-0 cursor-zoom-in" style="flex: 863 1 0">
            <Image src={duoSeated} alt="Blankie on iPhone Duo in the seated pose, with artwork on the upright half and sound tiles and the playback bar on the flat half" widths={[480, 900]} sizes="20rem" class="w-full" />
          </a>
          <a href={duoBook.src} data-zoom data-filename="blankie-iphone-duo-book.png" class="min-w-0 cursor-zoom-in" style="flex: 1246 1 0">
            <Image src={duoBook} alt="Blankie on iPhone Duo in the book pose, with Now Playing on the left page and the Sound Mixer on the right" widths={[600, 1200]} sizes="28rem" class="w-full" />
          </a>
        </div>
        <figcaption class="mt-2.5 text-center text-sm text-fg-3">iPhone Duo in the seated and book poses</figcaption>
      </figure>

      <blockquote class="my-7.5 border-l-[3px] border-warm py-0.5 pl-6">
        <p class="mb-3.5 text-[20px] leading-[1.52] font-medium tracking-[-0.01em] text-pretty text-white">
          "I've wanted widgets in Blankie since day one, and now that they're here, I can't stop using them. Lots of apps pester you to open them because that's how they make money. With Blankie's widgets, you might never open the app again, and that's okay! Blankie will always be free, with nothing to upsell and no reason&nbsp;to&nbsp;nag."
        </p>
        <cite class="text-sm font-semibold text-fg-3 not-italic">Cody Bromley, creator of Blankie</cite>
      </blockquote>

      <p>
        First released on Mac in April 2025 and brought to iPhone, iPad and CarPlay in June 2026, Blankie has been downloaded more than 25,000 times across the App Store, GitHub and Homebrew, and deployed to over 1,000 school and organization devices worldwide. It holds a 4.9-out-of-5 global App Store rating, has ranked on App Store charts in 92 countries and has nearly 400 stars on GitHub. All 24 built-in sounds and every feature are free, with no ads, subscriptions or tracking.
      </p>

      <p>
        Blankie is available now on the App Store for iPhone, iPad and Mac, as well as on Blankie.rest, GitHub and Homebrew for macOS. It requires iOS/iPadOS 26.4 or later, or macOS 26 or later.
      </p>

      <div class="mt-8.5 flex flex-wrap gap-3">
        <a
          class="inline-flex items-center gap-2.5 rounded-xl bg-moon px-5 py-3 text-sm font-semibold text-midnight no-underline transition hover:-translate-y-0.5"
          href="https://apps.apple.com/app/blankie/id6740096581"
        >
          <Download size={17} stroke-width={1.75} /> Download on the App Store
        </a>
        <a
          class="inline-flex items-center gap-2.5 rounded-xl border border-white/15 px-5 py-3 text-sm font-semibold text-fg-1 no-underline transition hover:-translate-y-0.5 hover:border-white/30"
          href="/press/#assets"
        >
          <Images size={17} stroke-width={1.75} /> Press images
        </a>
      </div>

      <div
        class="mt-11 grid grid-cols-1 items-start gap-12 border-t border-hair-soft pt-8.5 sm:grid-cols-[1fr_280px]"
      >
        <div>
          <h2 class="mb-3 text-xs font-bold tracking-widest text-warm uppercase">
            About Blankie
          </h2>
          <p class="text-[15.5px] leading-[1.68] text-fg-2">
            Blankie is a free, open-source ambient sound mixer for iPhone, iPad,
            Mac and CarPlay. It is built by independent developer Cody Bromley
            in Tulsa, Oklahoma, with contributors and translators around the
            world. Blankie includes 24 ambient sounds and lets you import your
            own audio files and voice memos, plays 100% offline and is
            translated into 12 languages.
          </p>
        </div>

        <div
          class="text-sm text-fg-2 [&_a]:border-b [&_a]:border-accent-ink/30 [&_a]:text-accent-ink [&_a]:no-underline [&_a:hover]:border-accent-ink"
        >
          <div class="text-[11px] font-bold tracking-[0.14em] text-warm uppercase">
            Media contact
          </div>
          <p class="mt-2 mb-4 text-[16px] font-semibold text-fg-1">Cody Bromley</p>
          <div class="grid gap-2.25">
            <div>
              <span class="inline-block min-w-23 text-[11px] font-semibold tracking-[0.08em] text-fg-3 uppercase">
                Email
              </span>
              <a href="mailto:press@blankie.rest">press@blankie.rest</a>
            </div>
            <div>
              <span class="inline-block min-w-23 text-[11px] font-semibold tracking-[0.08em] text-fg-3 uppercase">
                Press kit
              </span>
              <a href="/press/">blankie.rest/press</a>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-11 mb-2 text-center font-bold tracking-[0.5em] text-fg-3">###</div>
    </div>
  </article>
  <Lightbox />
</Layout>
