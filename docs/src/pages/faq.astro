---
import Layout from "../layouts/Layout.astro";
import { renderMarkdown } from "@/utils/markdown";
import { breadcrumbLd, faqPageLd, ldGraph } from "@/utils/schema";
import DownloadCTA from "@/components/DownloadCTA.astro";
import Prose from "@/components/Prose.astro";
// FAQ.md (repo root) is the single source of truth, also linked from the README
// and GitHub. ?raw keeps it watched in dev, so edits hot-reload.
import faqRaw from "../../../FAQ.md?raw";

const title = "Frequently Asked Questions.";
const description =
  "Common questions about Blankie, the free ambient sound mixer: getting started, whether it's free, importing your own sounds, privacy, supported languages, and how it compares to Blanket.";
const faqDek =
  "Here's answers to the most common questions about Blankie. Not seeing your question? Check out our <a href='/guides/'>guides</a> or <a href='https://forms.gle/fRwxBEQqPK5qgH427' target='_blank' rel='noopener'>contact us</a>.";

// FAQ.md is authored as ## sections each holding ### questions (with an optional
// lead paragraph before the first one).
const body = faqRaw
  // The layout renders the title as <h1>, so drop FAQ.md's own H1.
  .replace(/^#[^\n]*\n+/, "")
  // Repo-relative link works on GitHub; rewrite it for the site.
  .replace(/\]\(\/CONTRIBUTING\.md\)/g, "](/contributing/)");

const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

type FaqItem = { id: string; question: string; answer: string };
type FaqSection = { id: string; title: string; intro: string; items: FaqItem[] };

const faqSections: FaqSection[] = body
  .split(/^##\s+/m)
  .slice(1)
  .map((block: string): FaqSection => {
    const nl = block.indexOf("\n");
    const sectionTitle = block.slice(0, nl).trim();
    const parts = block.slice(nl + 1).split(/^###\s+/m);
    const lead = parts[0].trim();
    const items = parts.slice(1).map((q: string): FaqItem => {
      const qnl = q.indexOf("\n");
      const question = q.slice(0, qnl).trim();
      return {
        id: slugify(question),
        question,
        answer: renderMarkdown(q.slice(qnl + 1).trim()),
      };
    });
    return {
      id: slugify(sectionTitle),
      title: sectionTitle,
      intro: lead ? renderMarkdown(lead) : "",
      items,
    };
  });

const allItems = faqSections.flatMap((s) => s.items);

const path = "/faq/";
const jsonLd = ldGraph(
  faqPageLd(allItems),
  breadcrumbLd([
    { name: "Blankie", path: "/" },
    { name: "FAQ", path },
  ]),
);
---

<Layout title={title} description={description}>
  <article>
    <section class="pt-31 pb-27.5">
      <div class="mx-auto max-w-5xl px-5">
        <div class="grid grid-cols-1 items-start gap-7.5 min-[900px]:grid-cols-[220px_1fr] min-[900px]:gap-16">
          <nav
            class="faq-nav sticky top-23 max-[900px]:static max-[900px]:flex max-[900px]:flex-wrap max-[900px]:gap-x-4.5 max-[900px]:gap-y-1.5 max-[900px]:border-b max-[900px]:border-hair-soft max-[900px]:pb-4.5"
            id="faqnav"
          >
            {
              faqSections.map((sec) => (
                <div
                  class="faq-navgroup max-[900px]:contents [&+&]:mt-0.5"
                  data-sec={sec.id}
                >
                  <a
                    class="faq-navsec block w-full py-1.75 text-[15px] font-semibold text-fg-2 no-underline transition-colors hover:text-fg-1 [.active>&]:text-white"
                    href={`#faq-${sec.id}`}
                  >
                    {sec.title}
                  </a>
                  <div class="faq-navsub mt-0.5 mb-2 hidden border-l border-hair-soft max-[900px]:hidden! in-[.active]:block">
                    {sec.items.map((item) => (
                      <a
                        class="faq-navq block py-1.25 pl-3.25 text-[13px] leading-snug text-fg-3 no-underline transition-colors hover:text-fg-1 [&.on]:-ml-px [&.on]:pl-3.5 [&.on]:text-white [&.on]:shadow-[inset_2px_0_0_var(--color-warm)]"
                        href={`#${item.id}`}
                        data-q={item.id}
                      >
                        {item.question}
                      </a>
                    ))}
                  </div>
                </div>
              ))
            }
          </nav>

          <div>
            <header class="mb-2.5">
              <h1 class="my-6 max-w-[24ch] text-[clamp(34px,5vw,56px)] leading-[1.04] font-semibold tracking-tighter text-balance">
                {title}
              </h1>
              <p
                class="max-w-[60ch] text-fg-2 editorial-links"
                set:html={faqDek}
              />
            </header>

            {
              faqSections.map((sec) => (
                <section
                  class="faq-sec [&+&]:mt-13.5"
                  id={`faq-${sec.id}`}
                  data-sec={sec.id}
                >
                  <div class="flex items-baseline gap-3.5 border-b border-hair pb-4">
                    <h2 class="text-[clamp(24px,3vw,32px)] font-semibold tracking-tight text-fg-1">
                      {sec.title}
                    </h2>
                  </div>
                  {sec.intro && (
                    <div
                      class="mt-4 max-w-[62ch] [&_p]:leading-relaxed [&_p]:text-fg-3"
                      set:html={sec.intro}
                    />
                  )}
                  {sec.items.map((item) => (
                    <div class="faq-q pt-6.5" id={item.id}>
                      <h3 class="text-[19px] font-semibold tracking-tight text-fg-1">
                        {item.question}
                      </h3>
                      <Prose html={item.answer} class="max-w-none pt-2" />
                    </div>
                  ))}
                </section>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <DownloadCTA
      blurb="No ads, no subscriptions, no accounts, no tracking. Just a library of ambient sounds to mix into your own soundscapes for focus, rest, and sleep, on iPhone, iPad, CarPlay and Mac."
    />
  </article>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <script>
    // Reading room: expand the section in view and highlight its question.
    document.addEventListener("DOMContentLoaded", () => {
      const nav = document.querySelector(".faq-nav");
      if (!nav) return;
      const groups = Array.from(
        document.querySelectorAll<HTMLElement>(".faq-navgroup"),
      );
      const qlinks = Array.from(
        document.querySelectorAll<HTMLElement>(".faq-navq"),
      );
      const questions = Array.from(
        document.querySelectorAll<HTMLElement>(".faq-q"),
      );
      if (!questions.length) return;

      const secOf = new Map<string, string>();
      document.querySelectorAll<HTMLElement>(".faq-sec").forEach((s) => {
        s.querySelectorAll<HTMLElement>(".faq-q").forEach((q) =>
          secOf.set(q.id, s.dataset.sec || ""),
        );
      });

      const setActive = (qId: string) => {
        const secId = secOf.get(qId) || "";
        groups.forEach((g) =>
          g.classList.toggle("active", g.dataset.sec === secId),
        );
        qlinks.forEach((l) => l.classList.toggle("on", l.dataset.q === qId));
      };

      const spy = new IntersectionObserver(
        (entries) => {
          const vis = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (vis.length) setActive((vis[0].target as HTMLElement).id);
        },
        { rootMargin: "-20% 0px -70% 0px" },
      );
      questions.forEach((q) => spy.observe(q));
      setActive(questions[0].id);
    });
  </script>
</Layout>
