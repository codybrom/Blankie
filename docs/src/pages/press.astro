    items: [
      {
        img: iphoneApp1,
        file: "iphone-mockup-1.png",
        label: "Now Playing",
        tall: true,
      },
      {
        img: iphoneApp2,
        file: "iphone-mockup-2.png",
        label: "Sound Mixer",
        tall: true,
      },
      ...storeItems("iphone", true),
      ...guideItems("iphone"),
    ],
  },
  {
    id: "ipad",
    title: "iPad",
    items: [
      { img: ipadMockup, file: "ipad-mockup.png", label: "App window" },
      ...storeItems("ipad", true),
      ...guideItems("ipad"),
    ],
  },
  {
    id: "mac",
    title: "Mac",
    items: [
      { img: macShot, file: "mac-mockup.png", label: "App window" },
      ...storeItems("mac", false),
      ...guideItems("mac"),
    ],
  },
  {
    id: "carplay",
    title: "CarPlay",
    items: [
      { img: carplayDash, file: "carplay-dash.png", label: "Dashboard" },
      ...guideItems("carplay"),
    ],
  }
];
---

<Layout title={title} description={description}>
  <div>
    <!-- hero -->
    <section class="relative pt-34 pb-14 text-center">
      <Glow
        class="-top-37.5 left-1/2 h-140 w-210 -translate-x-1/2"
        color="var(--color-b-yellow)"
        pct={9}
        fade={60}
      />
      <Glow class="-right-40 -bottom-50 size-170" pct={22} fade={64} />
      <div class="relative z-10 mx-auto max-w-5xl px-5">
        <Image
          src={heroIcon}
          alt="Blankie app icon"
          class="mx-auto mb-6 size-26 rounded-4xl shadow-[0_24px_56px_rgba(0,0,0,0.5),0_0_0_1px_rgba(255,255,255,0.05)]"
          width={104}
          height={104}
          densities={[2]}
          quality={90}
        />
        <h1
          class="mt-3.5 text-[clamp(38px,5.6vw,66px)] leading-[1.02] font-semibold tracking-tighter"
        >
          Blankie Press Kit
        </h1>
        <p class="mx-auto mt-4.5 max-w-[52ch] text-lg/relaxed text-fg-2">
          Everything you need to write about Blankie, the free and open-source
          ambient sound mixer for iPhone, iPad, Mac, CarPlay and HomeView.
        </p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <Button variant="moon" href="mailto:press@blankie.rest">
            <Mail size={17} stroke-width={1.75} /> press@blankie.rest
          </Button>
          <Button href="#assets">
            <Download size={17} stroke-width={1.75} /> Download assets
          </Button>
          <Button href="/press/blankie-2-2/">
            <FileText size={17} stroke-width={1.75} /> Read the 2.2 release
          </Button>
        </div>
        <div
          class="mt-12 flex flex-wrap justify-center border-y border-hair-soft"
        >
          {
            quick.map(([n, label]) => (
              <div class="flex flex-col gap-0.5 border-l border-hair-soft px-7 py-4.5 first:border-l-0">
                <b class="text-xl font-semibold tracking-tight">{n}</b>
                <span class="text-[10.5px] font-semibold tracking-wider text-fg-3 uppercase">
                  {label}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- summary -->
    <section class="scroll-mt-20 pt-14" id="summary">
      <div class="mx-auto max-w-5xl px-5">
        <SectionHeader rule heading="Summary" class="mb-6" />
        <div class="flex items-center gap-3 text-[11px] font-semibold tracking-widest text-fg-3 uppercase">
          One-liner
          <button
            type="button"
            data-copy="one-liner"
            class="inline-flex items-center gap-1 rounded-full border border-hair px-2.5 py-1 text-[11px] font-semibold tracking-normal text-fg-2 normal-case transition-colors hover:border-white/20 hover:text-white"
            hidden
          >
            <Copy size={12} aria-hidden="true" />
            <span data-copy-label>Copy</span>
          </button>
        </div>
        <p
          id="one-liner"
          class="mt-2.5 mb-10 text-[clamp(24px,3.4vw,34px)] leading-tight font-medium tracking-tight text-balance text-white"
        >
          Blankie is a <span class="text-warm">free and open-source</span> ambient
          sound mixer for iPhone, iPad, Mac, CarPlay and HomeView with no ugly ads, no sneaky
          business model and no compromises for your privacy.
        </p>
        <div class="flex items-center gap-3 text-[11px] font-semibold tracking-widest text-fg-3 uppercase">
          Short description
          <button
            type="button"
            data-copy="short-description"
            class="inline-flex items-center gap-1 rounded-full border border-hair px-2.5 py-1 text-[11px] font-semibold tracking-normal text-fg-2 normal-case transition-colors hover:border-white/20 hover:text-white"
            hidden
          >
            <Copy size={12} aria-hidden="true" />
            <span data-copy-label>Copy</span>
          </button>
        </div>
        <p id="short-description" class="mt-2.5 max-w-[76ch] leading-relaxed text-[#d4d7ea]">
          Blankie helps people sleep, relax and focus with 40 adjustable ambient
          sounds (rain, waves, fireplaces, coffee shops and more) that can be mixed into
          custom soundscapes. Listeners can import their own audio, set sleep
          timers, pick animated Lock Screen artwork and use Blankie in the car
          with CarPlay. Version 2.2 adds ambient music Kaleidoscopes with
          interactive visualizations. Version 2.1 brought Home Screen widgets,
          Siri and Shortcuts actions, Spotlight search and layouts for every
          pose of iPhone Duo.
          Blankie is open source, translated into 12 languages, accessible with
          VoiceOver and free forever.
        </p>
      </div>
    </section>

    <!-- coverage -->
    <section class="scroll-mt-20 pt-14" id="coverage">
      <div class="mx-auto max-w-5xl px-5">
        <SectionHeader rule heading="Recognition & coverage" class="mb-6" />

        {
          heroCoverage && (
            <figure class="relative isolate overflow-hidden rounded-3xl border border-hair bg-[linear-gradient(150deg,color-mix(in_srgb,var(--color-accent-blue)_18%,transparent),transparent_62%)] p-7 sm:p-11">
              <Glow class="-top-48 -right-32 -z-10 size-130" pct={20} fade={62} />
              <p class="text-[11px] font-semibold tracking-[0.16em] text-accent-ink uppercase">Featured in</p>
              <p class="mt-3 text-4xl font-semibold tracking-tight text-fg-1 sm:text-6xl">
                {heroCoverage.out}
              </p>
              <p class="mt-2 text-sm text-fg-3">
                <time datetime={heroCoverage.date} data-localize="month-year">{heroCoverage.monthYear}</time>
              </p>
              <div class="mt-7 flex flex-wrap items-end justify-between gap-x-8 gap-y-5">
                <blockquote class="max-w-2xl text-lg/snug text-balance text-fg-2 sm:text-xl/snug">
                  “{heroCoverage.quote}”
                </blockquote>
                {heroCoverage.url && (
                  <a
                    class="group inline-flex shrink-0 items-center gap-2 rounded-full bg-moon px-4 py-2.5 text-sm font-semibold text-midnight no-underline transition hover:-translate-y-0.5"
                    href={heroCoverage.url}
                  >
                    {heroCoverage.Icon && <heroCoverage.Icon size={15} aria-hidden="true" />}
                    {heroCoverage.cta}
                    <ArrowRight size={14} class="transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                  </a>
                )}
              </div>
            </figure>
          )
        }

        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-12">
          {
            pinnedCards.map(({ out, Icon, cta, headline, quote, date, monthYear, url }, i) => {
              const Tile = url ? "a" : "div";
              return (
                <li
                  class:list={[
                    "grid",
                    cardSpan(i, pinnedCards.length),
                    pinnedCards.length % 2 === 1 && i === pinnedCards.length - 1 && "sm:col-span-2",
                  ]}
                >
                  <Tile
                    href={url}
                    class:list={[
                      "flex min-h-36 flex-col justify-between gap-6 rounded-2xl border border-hair-soft bg-glass p-6 no-underline",
                      url &&
                        "group transition duration-200 hover:-translate-y-0.5 hover:border-hair hover:bg-glass-2 hover:shadow-[0_18px_40px_rgba(0,0,0,0.35)]",
                    ]}
                  >
                    <span class="grid gap-2">
                      <span class="text-2xl font-semibold tracking-tight text-fg-1 sm:text-[28px]">{out}</span>
                      {(headline || quote) && (
                        <span class="text-sm/snug text-balance text-fg-2">
                          <span class="sr-only">: </span>
                          {headline ?? `“${quote}”`}
                        </span>
                      )}
                    </span>
                    <span class="flex items-center justify-between gap-4 text-xs">
                      <span
                        class:list={[
                          "inline-flex items-center gap-1.5 font-semibold",
                          url ? "text-accent-ink transition-colors group-hover:text-fg-1" : "text-fg-3",
                        ]}
                      >
                        <span class="sr-only">. </span>
                        {Icon && <Icon size={14} class={Icon === Play ? "fill-current" : undefined} aria-hidden="true" />}
                        {url ? cta : "Featured"}
                        {url && (
                          <ArrowRight size={13} class="transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                        )}
                      </span>
                      <span class="sr-only">, </span>
                      <time class="text-fg-3" datetime={date} data-localize="month-year">
                        {monthYear}
                      </time>
                    </span>
                  </Tile>
                </li>
              );
            })
          }
        </ul>

        <h3 class="mt-14 mb-3 text-lg font-semibold tracking-tight text-fg-1">More coverage</h3>
        <div class="scroll-mt-28 border-t border-hair-soft pt-2" data-coverage-list>
          {
            morePages.map((page, p) => (
              <ul class="grid" data-coverage-page={p}>
                {page.map(({ out, Icon, cta, headline, quote, context, date, monthYear, url }) => (
                  <li>
                    <a
                      class="group -mx-3 grid grid-cols-[1fr_auto] items-baseline gap-x-4 rounded-xl px-3 py-2.5 no-underline transition-colors hover:bg-glass"
                      href={url}
                    >
                      <span class="min-w-0 text-sm/snug">
                        <span class="font-semibold text-fg-1">{out}</span>
                        <span class="text-fg-2">
                          {" · "}
                          {quote ? `“${quote}”` : (headline ?? context)}
                        </span>
                      </span>
                      <span class="sr-only">. </span>
                      <span class="flex items-center gap-3 text-xs whitespace-nowrap text-fg-3">
                        <span class="hidden items-center gap-1.5 font-semibold text-accent-ink transition-colors group-hover:text-fg-1 sm:inline-flex">
                          {Icon && <Icon size={13} class={Icon === Play ? "fill-current" : undefined} aria-hidden="true" />}
                          {cta}
                        </span>
                        {Icon && (
                          <Icon size={13} aria-hidden="true" class:list={["text-accent-ink sm:hidden", Icon === Play && "fill-current"]} />
                        )}
                        <span class="sr-only">, </span>
                        <time class="w-26 text-right tabular-nums" datetime={date} data-localize="month-year">
                          {monthYear}
                        </time>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
        <nav
          data-coverage-pager
          aria-label="More coverage pages"
          class="mt-3 flex items-center justify-center gap-1"
          hidden
        >
          <button
            type="button"
            data-step="-1"
            aria-label="Previous page"
            class="grid size-9 place-items-center rounded-full text-fg-2 transition-colors hover:bg-glass-2 hover:text-fg-1 disabled:pointer-events-none disabled:opacity-30"
          >
            <ArrowLeft size={15} />
          </button>
          {
            morePages.map((_, p) => (
              <button
                type="button"
                data-page={p}
                aria-label={`Page ${p + 1}`}
                class="grid size-9 place-items-center rounded-full text-sm font-semibold text-fg-3 tabular-nums transition-colors hover:bg-glass-2 hover:text-fg-1 aria-[current=page]:bg-glass-2 aria-[current=page]:text-fg-1 aria-[current=page]:ring-1 aria-[current=page]:ring-hair"
              >
                {p + 1}
              </button>
            ))
          }
          <button
            type="button"
            data-step="1"
            aria-label="Next page"
            class="grid size-9 place-items-center rounded-full text-fg-2 transition-colors hover:bg-glass-2 hover:text-fg-1 disabled:pointer-events-none disabled:opacity-30"
          >
            <ArrowRight size={15} />
          </button>
        </nav>
      </div>
    </section>

    <!-- press releases -->
    <section class="scroll-mt-20 pt-14" id="releases">
      <div class="mx-auto max-w-5xl px-5">
        <SectionHeader rule heading="Press releases" class="mb-6" />
        <div class="grid">
          {
            releases.map(({ title, date, url }) => (
              <div class="grid grid-cols-1 items-baseline gap-1 border-t border-hair-soft py-4 first:border-t-0 sm:grid-cols-[1fr_auto] sm:gap-6">
                <a
                  class="group inline-flex items-center gap-1.5 font-semibold tracking-tight text-fg-1 no-underline transition-colors hover:text-accent-ink"
                  href={url}
                >
                  {title}
                  <ArrowRight
                    class="shrink-0 text-fg-3 transition-colors group-hover:text-accent-ink"
                    size={13}
                  />
                </a>
                <time
                  class="text-[11px] tracking-wide whitespace-nowrap text-fg-3 sm:text-right"
                  datetime={date}
                  data-localize="day"
                >
                  {apDate(date)}
                </time>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- fact sheet -->
    <section class="scroll-mt-20 pt-14" id="facts">
      <div class="mx-auto max-w-5xl px-5">
        <SectionHeader rule heading="Fact sheet" class="mb-6" />
        <dl class="grid [&_dd]:leading-normal [&_dd]:text-fg-1">
          {
            facts.map((f) => (
              <DefRow term={f.t}>
                {f.href ? (
                  <a class="border-b border-accent-ink/35 text-fg-1 no-underline transition-colors hover:border-accent-ink" href={f.href}>
                    {f.d}
                  </a>
                ) : (
                  f.d
                )}
                {f.d && f.m ? " " : ""}
                {f.m && <span class="text-fg-2">{f.m}</span>}
              </DefRow>
            ))
          }
          <DefRow term="Links">
            <div class="flex flex-wrap gap-x-5 gap-y-2">
              {
                links.map(([label, href]) => (
                  <a
                    class="inline-flex items-center gap-1.5 border-b border-transparent text-sm text-accent-ink no-underline transition-[border-color] hover:border-accent-ink"
                    href={href}
                  >
                    {label} <ArrowUpRight size={13} />
                  </a>
                ))
              }
            </div>
          </DefRow>
        </dl>
      </div>
    </section>

    <!-- why it's a story -->
    <section class="pt-14">
      <div class="mx-auto max-w-5xl px-5">
        <SectionHeader rule heading="Why Blankie?" class="mb-6" />
        <ul class="grid grid-cols-1 gap-x-10 md:grid-cols-2">
          {
            highlights.map((h) => (
              <li class="flex items-start gap-3 border-t border-hair-soft py-3 text-sm/normal text-[#d4d7ea] nth-[-n+2]:border-t-0 max-md:nth-2:border-t">
                <Check class="mt-0.5 shrink-0 text-warm" size={17} stroke-width={2} />
                {h}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- reviews -->
    <section class="scroll-mt-20 pt-14" id="reviews">
      <div class="mx-auto max-w-5xl px-5">
        <SectionHeader rule heading="Reviews" class="mb-6" />
        <div class="columns-1 gap-4 min-[600px]:columns-2 min-[900px]:columns-3">
          {
            reviewIds.map((id) => (
              <div class="mb-4 break-inside-avoid">
                <Testimonial id={id} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- assets -->
    <section class="scroll-mt-20 pt-14" id="assets">
      <div class="mx-auto max-w-5xl px-5">
        <SectionHeader rule heading="Images & assets" class="mb-6" />
        <div class="mb-7 flex flex-wrap items-center justify-between gap-4">
          <p class="max-w-[60ch] text-sm text-fg-3">
            Free to use in coverage of Blankie. Need something specific? Localized
            screenshots and videos available on request.
          </p>
          <div class="flex shrink-0 flex-wrap gap-2">
            <Button
              size="sm"
              href="https://github.com/codybrom/blankie/releases/download/press-screenshots/blankie-2.1-screenshots.zip"
            >
              <Download size={15} stroke-width={1.75} /> App Store screenshots
            </Button>
            <Button size="sm" href="/blankie-press-kit.zip" download>
              <Download size={15} stroke-width={1.75} /> Download all
            </Button>
          </div>
        </div>
        <nav class="mb-8 flex flex-wrap gap-2" aria-label="Asset groups" data-asset-tabs>
          {
            assetGroups.map((group) => (
              <a
                href={`#${group.id}`}
                data-asset-tab={group.id}
                class="rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-sm font-medium text-fg-2 no-underline transition-colors hover:border-white/20 hover:text-white aria-[current=true]:border-white/25 aria-[current=true]:bg-white/12 aria-[current=true]:text-white"
              >
                {group.title}
                <span class="ml-1.5 text-fg-3">{group.items.length}</span>
              </a>
            ))
          }
        </nav>
        {
          assetGroups.map((group) => {
            // Mixed-orientation groups (iPad: landscape window shot plus portrait
            // store images) pack better as masonry. The rest use an even grid.
            const mixed =
              group.items.some((i) => i.tall) &&
              group.items.some((i) => !i.tall);
            return (
              <div class="scroll-mt-28 [&+&]:mt-9" id={group.id} data-asset-group={group.id}>
                <h3 class="mb-3.5 text-xs font-semibold tracking-wide text-fg-3 uppercase">
                  {group.title}
                </h3>
                <div
                  class:list={[
                    mixed
                      ? "columns-1 gap-4 min-[520px]:columns-2 min-[820px]:columns-3"
                      : "grid grid-cols-1 items-start gap-4 min-[520px]:grid-cols-2 min-[820px]:grid-cols-3",
                  ]}
                >
                  {group.items.map(({ img, video, captions, file, label, pad, tall }) => (
                    <div
                      class:list={[
                        "overflow-hidden rounded-xl border border-hair bg-glass transition hover:-translate-y-0.5 hover:border-white/20",
                        { "mb-4 break-inside-avoid": mixed },
                      ]}
                    >
                      <div
                        class:list={[
                          "flex items-center justify-center overflow-hidden bg-[linear-gradient(160deg,#0c1130,#06091f)] p-4",
                          tall ? "aspect-3/4" : "aspect-16/10",
                        ]}
                      >
                        {video ? (
                        <video
                          src={video}
                          poster={img.src}
                          controls
                          playsinline
                          preload="none"
                          aria-label={`${group.title}, ${label}`}
                          class="max-h-full max-w-full rounded-md"
                        >
                          <track kind="captions" src={captions} srclang="en" label="English" />
                        </video>
                        ) : (
                        <a href={img.src} data-zoom data-download={img.src} data-filename={`blankie-${file.split("/").pop()}`} class="contents">
                        <Image
                          src={img}
                          alt={`${group.title}, ${label}`}
                          quality={82}
                          widths={pad ? upTo(img, [84, 168, 252]) : upTo(img, [400, 640, 960, 1280])}
                          sizes={pad ? "84px" : "(min-width: 1024px) 320px, (min-width: 640px) 45vw, 100vw"}
                          class:list={[
                            "max-h-full max-w-full object-contain",
                            pad ? "max-h-21 rounded-[22%]" : "rounded-md",
                          ]}
                        />
                        </a>
                        )}
                      </div>
                      <div class="flex items-center justify-between gap-2.5 border-t border-hair-soft px-4 py-3">
                        <span class="text-sm font-medium text-fg-1">{label}</span>
                        <a
                          class="inline-flex items-center gap-1.5 text-[11px] font-semibold whitespace-nowrap text-accent-ink no-underline"
                          href={`${raw}/${file}`}
                          download
                        >
                          <Download size={12} /> {file.split(".").pop()?.toUpperCase()}
                        </a>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- about the developer -->
    <section class="scroll-mt-20 pt-14 pb-6" id="about">
      <div class="mx-auto max-w-5xl px-5">
        <SectionHeader rule heading="About the developer" class="mb-6" />
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
        <figure class="shrink-0">
          <div
            role="img"
            aria-label="Cody Bromley"
            class="size-32 rounded-full bg-cover bg-center ring-1 ring-hair sm:size-36"
            style={portraitStyle}
          ></div>
          <figcaption class="mt-2 text-center text-[11px] text-fg-3">
            Photo by Henry Ninde ·{" "}
            <a
              class="inline-flex align-[-2px] text-accent-ink transition-colors hover:text-fg-1"
              href={headshot.src}
              rel="nofollow"
              download
              title="Download headshot"
            >
              <Download size={13} aria-hidden="true" />
              <span class="sr-only">Download headshot</span>
            </a>
          </figcaption>
        </figure>
        <div>
        <p class="max-w-[76ch] leading-relaxed text-[#d4d7ea]">
          Cody Bromley is an independent developer from Tulsa, Oklahoma. He built
          Blankie in the great tradition of free Mac and iPhone apps that solve a
          problem elegantly. Blankie stays free forever with help from contributors
          and translators around the world. He's available for interviews and
          podcasts to talk about Blankie, indie development and why building free and
          open-source apps for the App Store matters.
        </p>
        <p class="mt-5 text-sm text-fg-3">
          <a
            class="text-accent-ink no-underline hover:underline"
            href="mailto:press@blankie.rest">press@blankie.rest</a
          > ·
          <a
            class="text-accent-ink no-underline hover:underline"
            href="https://github.com/codybrom">github.com/codybrom</a
          >
        </p>
        </div>
        </div>
      </div>
    </section>
  </div>
  <Lightbox />

  <nav
    class="press-pill is-hidden fixed bottom-8 left-1/2 z-40 inline-flex -translate-x-1/2 items-center gap-1 rounded-full border border-white/10 bg-[color-mix(in_srgb,var(--color-midnight)_72%,transparent)] p-1.5 shadow-[0_10px_30px_rgba(0,0,0,0.4)] backdrop-blur-[22px] backdrop-saturate-150 transition-[opacity,transform] duration-350 [&.is-hidden]:pointer-events-none [&.is-hidden]:translate-y-5 [&.is-hidden]:opacity-0"
    aria-label="Page sections"
  >
    {
      [
        ["summary", "Summary"],
        ["coverage", "Coverage"],
        ["facts", "Facts"],
        ["assets", "Images"],
        ["about", "About"],
      ].map(([id, label]) => (
        <a
          href={`#${id}`}
          data-section={id}
          class="rounded-full px-4 py-2 text-sm font-medium whitespace-nowrap text-fg-2 no-underline transition-colors hover:text-white max-[520px]:px-2.5 max-[520px]:text-xs [&.active]:bg-white/8 [&.active]:text-white"
        >
          {label}
        </a>
      ))
    }
  </nav>

  <script>
    // Summary copy buttons put the paragraph's plain text on the clipboard.
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      const source = document.getElementById(button.dataset.copy ?? "");
      const label = button.querySelector("[data-copy-label]");
      if (!source || !label || !navigator.clipboard) return;
      button.hidden = false;
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(source.textContent?.replace(/\s+/g, " ").trim() ?? "");
        } catch {
          return;
        }
        label.textContent = "Copied";
        setTimeout(() => {
          label.textContent = "Copy";
        }, 1600);
      });
    });

    // Asset chips show one group at a time. Without JavaScript every group shows.
    const assetTabs = document.querySelectorAll<HTMLAnchorElement>("[data-asset-tab]");
    const assetGroupEls = document.querySelectorAll<HTMLElement>("[data-asset-group]");
    const showAssets = (id: string) => {
      assetGroupEls.forEach((group) => {
        group.hidden = group.dataset.assetGroup !== id;
      });
      assetTabs.forEach((tab) => {
        tab.setAttribute("aria-current", String(tab.dataset.assetTab === id));
      });
    };
    if (assetTabs.length && assetGroupEls.length) {
      const ids = [...assetTabs].map((t) => t.dataset.assetTab ?? "");
      const fromHash = location.hash.slice(1);
      showAssets(ids.includes(fromHash) ? fromHash : ids[0]);
      assetTabs.forEach((tab) => {
        tab.addEventListener("click", (event) => {
          event.preventDefault();
          showAssets(tab.dataset.assetTab ?? ids[0]);
          history.replaceState(null, "", `#${tab.dataset.assetTab}`);
        });
      });
    }

    // The floating section bar appears after the hero and marks the section in view.
    const pill = document.querySelector<HTMLElement>(".press-pill");
    const summary = document.getElementById("summary");
    if (pill && summary) {
      const links = pill.querySelectorAll<HTMLAnchorElement>("a[data-section]");
      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            links.forEach((link) => {
              link.classList.toggle("active", link.dataset.section === entry.target.id);
            });
          });
        },
        { rootMargin: "-45% 0px -45% 0px" },
      );
      links.forEach((link) => {
        const section = document.getElementById(link.dataset.section ?? "");
        if (section) spy.observe(section);
      });
      let queued = false;
      const update = () => {
        queued = false;
        pill.classList.toggle("is-hidden", summary.getBoundingClientRect().top > window.innerHeight * 0.6);
      };
      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      };
      update();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
    }

    // Press dates show in the reader's own locale. Month-precision dates
    // ("2026-11") are read as the first of the month.
    const formats: Record<string, Intl.DateTimeFormatOptions> = {
      day: { month: "short", day: "numeric", year: "numeric" },
      "month-year": { month: "long", year: "numeric" },
    };
    // English readers keep the AP-style dates the page was built with.
    const english = (navigator.languages[0] ?? navigator.language).toLowerCase().startsWith("en");
    document.querySelectorAll<HTMLTimeElement>("time[data-localize]").forEach((time) => {
      const options = formats[time.dataset.localize ?? ""];
      if (!options || (english && time.dataset.localize === "day")) return;
      const iso = time.dateTime.length === 7 ? `${time.dateTime}-01` : time.dateTime;
      time.textContent = new Intl.DateTimeFormat(navigator.languages, {
        ...options,
        timeZone: "UTC",
      }).format(new Date(`${iso}T12:00:00Z`));
    });

    // "More coverage" shows one page at a time once JavaScript runs.
    const pager = document.querySelector<HTMLElement>("[data-coverage-pager]");
    const list = document.querySelector<HTMLElement>("[data-coverage-list]");
    const pages = list?.querySelectorAll<HTMLElement>("[data-coverage-page]");
    if (pager && list && pages && pages.length > 1) {
      const numbers = pager.querySelectorAll<HTMLButtonElement>("[data-page]");
      const prev = pager.querySelector<HTMLButtonElement>('[data-step="-1"]');
      const next = pager.querySelector<HTMLButtonElement>('[data-step="1"]');
      let current = 0;
      const show = (index: number, scroll: boolean) => {
        current = index;
        pages.forEach((page, i) => {
          page.hidden = i !== index;
        });
        numbers.forEach((button, i) => {
          if (i === index) button.setAttribute("aria-current", "page");
          else button.removeAttribute("aria-current");
        });
        if (prev) prev.disabled = index === 0;
        if (next) next.disabled = index === pages.length - 1;
        if (scroll && list.getBoundingClientRect().top < 80) {
          list.scrollIntoView({ block: "start" });
        }
      };
      pager.addEventListener("click", (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>("button");
        if (!button) return;
        const target = button.dataset.page
          ? Number(button.dataset.page)
          : current + Number(button.dataset.step);
        if (target >= 0 && target < pages.length) show(target, true);
      });
      pager.hidden = false;
      show(0, false);
    }
  </script>
</Layout>
