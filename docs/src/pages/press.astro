// Articles say "Read more", features "See more". Videos say where Blankie comes up ("Watch from 9:20").
const coverageCtas: Record<CoverageType, string> = {
  Article: "Read more",
  Feature: "See more",
  Video: "Watch",
};
const coverageIcons: Record<CoverageType, typeof Play> = {
  Article: BookOpen,
  Feature: Sparkles,
  Video: Play,
};
const ctaFor = (type: CoverageType, url?: string) => {
  const t = type === "Video" && url ? Number(new URL(url).searchParams.get("t")?.replace("s", "")) : 0;
  if (!t) return coverageCtas[type];
  return `Watch from ${Math.floor(t / 60)}:${String(t % 60).padStart(2, "0")}`;
};
// English fallbacks for readers without JavaScript. The page script swaps in
// the reader's own locale using each <time>'s datetime.
const englishDate = (date: string, options: Intl.DateTimeFormatOptions) =>
  new Date(`${date.slice(0, 7)}-01T12:00:00Z`).toLocaleDateString("en-US", {
    ...options,
    timeZone: "UTC",
  });
const withDisplay = (c: (typeof coverage)[number]) => ({
  ...c,
  Icon: coverageIcons[c.type],
  cta: ctaFor(c.type, c.url),
  monthYear: englishDate(c.date, { month: "long", year: "numeric" }),
});
// Pinned entries are about who covered Blankie, so they lead with the outlet's
// name. The first one with a quote is the hero, and the rest follow as tiles
// in the order listed.
// Everything else is listed newest first under "More coverage".
const pinnedCoverage = coverage.filter((c) => c.pinned).map(withDisplay);
const heroCoverage = pinnedCoverage.find((c) => c.quote);
const pinnedCards = pinnedCoverage.filter((c) => c !== heroCoverage);
// Cards fill rows of three (or four, when that divides evenly) on large
// screens. A short last row stretches to fill the width.
const cardSpan = (i: number, n: number) => {
  const perRow = n % 4 === 0 ? 4 : 3;
  const lastRow = n % perRow;
  const full = perRow === 4 ? "lg:col-span-3" : "lg:col-span-4";
  if (!lastRow || i < n - lastRow) return full;
  return lastRow === 1 ? "lg:col-span-12" : "lg:col-span-6";
};
const moreCoverage = coverage
  .filter((c) => !c.pinned)
  .sort((a, b) => b.date.localeCompare(a.date))
  .map(withDisplay);
// Shown 8 at a time. Without JavaScript every page stays visible.
const morePageSize = 8;
const morePages = Array.from({ length: Math.ceil(moreCoverage.length / morePageSize) }, (_, i) =>
  moreCoverage.slice(i * morePageSize, (i + 1) * morePageSize),
);

// A handful of verbatim App Store reviews for the press kit (see testimonials.ts).
// Ordered to interleave long and short quotes so the masonry columns balance.
const reviewIds = [
  "carplay-standout",
  "straightforward",
  "pencil-neighbor",
  "coworking",
  "no-paywall-sleep",
  "macht-genau",
];

type Asset = {
  img: ImageMetadata;
  /** Plays this video (with controls) in the tile; img is its poster. */
  video?: string;
  captions?: string;
  file: string;
  label: string;
  pad?: boolean;
  tall?: boolean;
};
// The 2.1 App Store screenshots, as {device}-store-{n}.jpg (full-quality JPEG;
// the lossless PNGs are in the press-screenshots release zip).
const storeShots = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/*-store-*.jpg",
  { eager: true },
);
const storeItems = (device: string, tall: boolean): Asset[] =>
  Object.entries(storeShots)
    .map(([path, mod]) => ({
      path,
      n: Number(path.match(/-store-(\d+)\.jpg$/)?.[1]),
      img: mod.default,
    }))
    .filter(({ path }) => path.includes(`/${device}-store-`))
    .sort((a, b) => a.n - b.n)
    .map(({ path, n, img }) => ({
      img,
      file: path.split("/").pop() ?? "",
      label: `App Store ${n}`,
      tall,
    }));

// Screenshots from the guides, grouped by the device prefix in their file name
// (iphone-name.png). Files without one, like cover art and the Duo poses shown
// above, stay out of these groups.
const guideShots = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/guides/**/*.png",
  { eager: true },
);
const guideItems = (device: string): Asset[] =>
  Object.entries(guideShots)
    .map(([path, mod]) => [path.split("/").pop() ?? "", path, mod] as const)
    .filter(([fileName]) => fileName.startsWith(`${device}-`))
    .map(([fileName, path, mod]) => {
      const file = path.replace("../assets/", "");
      const name = fileName
        .slice(device.length + 1)
        .replace(/\.png$/, "")
        .replaceAll("-", " ");
      return {
        img: mod.default,
        file,
        label: name.charAt(0).toUpperCase() + name.slice(1),
        tall: device === "iphone",
      };
    })
    .sort((a, b) => a.label.localeCompare(b.label));

// The developer photo is drawn as a background image, sharp at 1x, 2x and 3x.
const portrait = await getImage({ src: headshot, width: 160, height: 160, densities: [1, 2, 3] });
const portraitStyle = `background-image: url(${portrait.src}); background-image: image-set(${portrait.srcSet.values
  .map((v) => `url(${v.url}) ${v.descriptor}`)
  .join(", ")});`;

// Responsive widths up to the source's own width (never upscaled).
const upTo = (img: ImageMetadata, widths: number[]) => [
  ...widths.filter((w) => w < img.width),
  img.width,
];

