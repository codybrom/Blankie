---
import Layout from "../layouts/Layout.astro";
import languagesJson from "../../public/i18n/languages.json";
import { getLanguageName, getNativeLanguageName } from "../utils/i18n-helpers";
import { I18nStats, type LanguageRow } from "@/components/I18nStats";
import { Card } from "@/components/ui/card";

const title = "Translation Status";

// Define types for the language data structure
interface StringStats {
  totalStrings: number;
  translatedStrings: number; // Finalized/reviewed strings
  needsReviewStrings: number; // Strings that have translations but need review
  untranslatedStrings: number; // Strings that haven't been translated at all
  translationPercentage: number; // Percentage of finalized strings
  needsReviewPercentage: number; // Percentage of strings needing review
  untranslatedPercentage: number; // Percentage of strings not translated
}

interface LanguageData {
  metadata: {
    extractedAt: string;
    languages: string[];
  };
  statistics: Record<string, StringStats>;
}

// Fetch the languages.json data at build time
const languageData = languagesJson as unknown as LanguageData;

// Sort languages by native language name (ascending)
const sortedLanguages = Object.entries(languageData.statistics).sort(
  ([langCodeA], [langCodeB]) => {
    const nameA = getNativeLanguageName(langCodeA);
    const nameB = getNativeLanguageName(langCodeB);
    return nameA.localeCompare(nameB);
  },
);

const extractionTimestamp = languageData.metadata.extractedAt;

// Function to calculate combined progress (translated + needs review)
function getCombinedProgress(stats: StringStats): number {
  return stats.translationPercentage + stats.needsReviewPercentage;
}

// Status accent (left border) color for each language card
function getAccentClass(stats: StringStats): string {
  const combinedProgress = getCombinedProgress(stats);

  if (stats.translationPercentage >= 90) return "border-accent";
  if (stats.translationPercentage >= 70) return "border-accent-ink";
  if (combinedProgress >= 50) return "border-warm";
  if (combinedProgress > 0) return "border-warm/60";
  return "border-fg-3/50";
}

// Function to determine the status text based on combined progress
function getStatusText(stats: StringStats): string {
  const { translationPercentage, needsReviewPercentage } = stats;
  const combinedProgress = translationPercentage + needsReviewPercentage;

  if (translationPercentage >= 99) return "Complete";
  if (translationPercentage >= 90) return "Mostly Complete";
  if (translationPercentage >= 85) return "Well Translated";

  if (combinedProgress >= 90) {
    if (needsReviewPercentage > translationPercentage)
      return "Almost Translated";
    return "Nearly Complete";
  }

  if (combinedProgress >= 50) {
    if (needsReviewPercentage > translationPercentage)
      return "Partially Translated";
    return "In Progress";
  }

  if (combinedProgress > 0) {
    if (translationPercentage === 0) return "Translation Needs Review";
    return "Getting Started";
  }

  return "Not Started";
}

// Badge variant for each language's status
function getStatusVariant(stats: StringStats): LanguageRow["statusVariant"] {
  if (stats.translationPercentage >= 90) return "default";
  if (stats.translationPercentage >= 70) return "secondary";
  if (getCombinedProgress(stats) > 0) return "outline";
  return "outline";
}

// Pre-compute display-ready rows for the stats table
const tableRows: LanguageRow[] = sortedLanguages.map(([langCode, stats]) => ({
  langCode,
  title:
    langCode === "en-GB"
      ? "English (United Kingdom)"
      : getNativeLanguageName(langCode),
  subtitle: langCode === "en-GB" ? "English (UK)" : getLanguageName(langCode),
  status: getStatusText(stats),
  statusVariant: getStatusVariant(stats),
  finalizedPct: stats.translationPercentage,
  reviewPct: stats.needsReviewPercentage,
  translated: stats.translatedStrings,
  total: stats.totalStrings,
  needsReview: stats.needsReviewStrings,
  accentClass: getAccentClass(stats),
  detailHref: `/i18n/${langCode}/`,
}));
---

<Layout title={title}>
  <div class="mx-auto max-w-5xl px-5 pt-28 pb-10">
    <h1 class="mb-6 text-4xl font-semibold tracking-tight">Translation Status</h1>

    <Card className="mb-8 gap-0 overflow-visible p-6">
      <p class="mb-4 leading-relaxed">
        This page shows the current translation status for Blankie. The data is
        automatically updated whenever new translations are added.
      </p>

      <div
        class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-center"
      >
        <div class="flex flex-wrap gap-3">
          <div class="dropdown relative inline-block">
            <button
              class="inline-flex items-center rounded-lg border border-hair bg-glass-2 px-4 py-2 text-sm text-fg-1 transition-colors hover:border-white/20 hover:bg-white/10"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="download-dropdown"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="mr-2 size-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                ></path>
              </svg>
              Download Template
              <svg
                class="ml-2 size-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div
              id="download-dropdown"
              class="dropdown-menu absolute right-0 z-50 mt-2 hidden w-48 rounded-md border border-hair bg-lift py-2 shadow-[0_2px_5px_rgba(0,0,0,0.2)]"
              role="menu"
              aria-labelledby="download-dropdown-button"
            >
              <a
                href="/i18n/source.json"
                target="_blank"
                class="block px-4 py-2 text-sm text-fg-2 transition-colors hover:bg-white/5 hover:text-white"
              >
                JSON Format
              </a>
              <a
                href="/i18n/source.csv"
                target="_blank"
                class="block px-4 py-2 text-sm text-fg-2 transition-colors hover:bg-white/5 hover:text-white"
              >
                CSV Format
              </a>
            </div>
          </div>

          <a
            href="https://github.com/codybrom/Blankie/tree/main?tab=contributing-ov-file#getting-started-with-translations"
            class="bg-primary-blue inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium text-white no-underline transition-colors hover:bg-deep-blue"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="mr-2 size-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
            Translation Guide
          </a>
        </div>

        <p class="text-fg-3 text-sm">
          Last updated: <span
            id="localTime"
            data-timestamp={extractionTimestamp}>{extractionTimestamp}</span
          >
        </p>
      </div>
    </Card>

    {
      !languageData && (
        <div class="mb-8 rounded-lg border border-red-500/40 bg-red-500/10 p-6">
          <h2 class="mb-2 text-xl font-semibold">
            Error Loading Translation Data
          </h2>
          <p>
            We couldn't load the latest translation statistics. Please try again
            later.
          </p>
        </div>
      )
    }

    {languageData && <I18nStats rows={tableRows} />}

    <Card className="mt-12 gap-0 p-6">
      <h2 class="mb-4 text-2xl font-semibold">About Translations</h2>
      <p class="mb-4">
        Blankie is translated by volunteers. If you'd like to help translate
        Blankie into your language, please check the
        <a
          href="/contributing/#translation-contributions"
          class="text-accent-ink underline transition-colors hover:text-white"
        >
          contribution guidelines
        </a>.
      </p>

      <h3 class="mt-6 mb-3 text-xl font-semibold">
        Getting Started with Translation
      </h3>
      <ol class="mb-4 list-inside list-decimal space-y-2">
        <li>
          Download the <a
            href="/i18n/"
            class="text-accent-ink underline transition-colors hover:text-white"
            >English template</a
          > to use as your starting point
        </li>
        <li>
          Translate the strings by editing the JSON or CSV file (keep the
          original keys and structure)
        </li>
        <li>
          Submit your translations either:
          <ul class="mt-2 ml-6 list-inside list-disc space-y-1">
            <li>
              Through a GitHub issue using the <a
                href="https://github.com/codybrom/blankie/issues/new?assignees=&labels=translation-contribution&projects=&template=translation_contribution.yml&title=%5BTranslation%5D%3A+"
                class="text-accent-ink underline transition-colors hover:text-white"
                >Translation contribution</a
              > template
            </li>
            <li>
              Or by emailing them to <a
                href="mailto:i18n@blankie.rest"
                class="text-accent-ink underline transition-colors hover:text-white"
                >i18n@blankie.rest</a
              >
            </li>
          </ul>
        </li>
      </ol>

      <h3 class="mt-6 mb-3 text-xl font-semibold">Understanding the Status</h3>
      <p class="mb-3">We track translation progress in two categories:</p>
      <ul class="mb-4 list-inside list-disc space-y-2">
        <li class="marker:text-accent">
          <strong>Finalized</strong>: Translations that are ready for use
        </li>
        <li class="marker:text-warm">
          <strong>In Review</strong>: Translations that need validation
        </li>
      </ul>

      <p class="mb-3">Status labels are based on the combined progress:</p>
      <ul class="list-inside list-disc space-y-2">
        <li><strong>Complete</strong>: 90%+ strings finalized</li>
        <li>
          <strong>Well Translated/Nearly Complete</strong>: 70%+ finalized or
          90%+ combined progress
        </li>
        <li><strong>In Progress</strong>: 50%+ combined progress</li>
        <li>
          <strong>Getting Started/All Needs Review</strong>: Some strings
          translated or in review
        </li>
        <li><strong>Not Started</strong>: No translation work yet</li>
      </ul>

      <h3 class="mt-6 mb-3 text-xl font-semibold">Needs Review</h3>
      <p>
        Strings marked as "needs review" are translations that may need
        attention, such as strings that:
      </p>
      <ul class="mt-2 list-inside list-disc space-y-1">
        <li>Were automatically translated and need human verification</li>
        <li>May not match the context correctly</li>
        <li>Need updates after the source string changed</li>
      </ul>

      <h3 class="mt-6 mb-3 text-xl font-semibold">Working with Translations</h3>
      <p>
        On a language page, you can download translations as CSV files to work
        on them in spreadsheet software. After making changes, you can
        contribute by submitting a GitHub issue with your translation file. If
        you're comfortable using Xcode, you can also fork the repository, import
        changes from a CSV or JSON file <a
          href="/contributing/#translation-contributions"
          class="text-accent-ink underline transition-colors hover:text-white"
          >using our import script</a
        >, then test locally and create a pull request with your changes.
      </p>

      <div class="my-6 border-t border-hair-soft"></div>

      <p class="mt-6 mb-4">
        Find an issue with existing translations or have general feedback? Email <a
          href="mailto:i18n@blankie.rest"
          class="text-accent-ink underline transition-colors hover:text-white"
          >i18n@blankie.rest</a
        >.
      </p>
    </Card>
  </div>
</Layout>

<script>
  // Handle dropdown functionality
  const dropdownButton = document.querySelector(".dropdown button");
  const dropdownMenu = document.querySelector(".dropdown-menu");

  if (dropdownButton && dropdownMenu) {
    // Toggle dropdown
    dropdownButton.addEventListener("click", (e) => {
      e.stopPropagation();
      const isExpanded = dropdownMenu.classList.contains("hidden");
      dropdownMenu.classList.toggle("hidden");
      dropdownButton.setAttribute(
        "aria-expanded",
        isExpanded ? "true" : "false",
      );
    });

    // Close dropdown when clicking outside
    document.addEventListener("click", () => {
      dropdownMenu.classList.add("hidden");
      dropdownButton.setAttribute("aria-expanded", "false");
    });

    // Prevent closing when clicking inside dropdown
    dropdownMenu.addEventListener("click", (e) => {
      e.stopPropagation();
    });
  }

  // Add local time conversion
  const localTimeElement = document.getElementById("localTime");
  if (localTimeElement) {
    const timestamp = localTimeElement.getAttribute("data-timestamp");
    if (timestamp) {
      const utcDate = new Date(timestamp);
      localTimeElement.textContent = utcDate.toLocaleString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        timeZoneName: "short",
      });
    }
  }
</script>
