---
interface Props {
  videoSrc: string;
  posterSrc?: string;
}

const { videoSrc, posterSrc } = Astro.props;
---

<div class="absolute inset-0 bg-black opacity-80">
  <video
    id="background-video"
    muted
    playsinline
    aria-hidden="true"
    class="absolute top-1/2 left-1/2 min-h-full min-w-full -translate-1/2 object-cover opacity-40"
    poster={posterSrc}
  >
  </video>
  <span class="sr-only">
    Background video showing gentle ocean waves flowing, creating a calm ambient
    atmosphere.
  </span>
</div>

<script is:inline define:vars={{ videoSrc }}>
  document.addEventListener("DOMContentLoaded", () => {
    const video = document.getElementById("background-video");

    // Respect reduced-motion: leave the poster image in place and never load or
    // play the looping video for anyone who asked the OS to reduce motion.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    // Create an Intersection Observer
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Add source and load video when it comes into view
            if (!video.querySelector("source")) {
              const source = document.createElement("source");
              source.src = videoSrc;
              source.type = "video/mp4";
              video.appendChild(source);
              video.load();
              video.loop = true;
              video.autoplay = true;
              video.play().catch(() => {
                // Handle autoplay policy restrictions silently
              });
            }
            observer.unobserve(entry.target);
          }
        });
      },
      {
        rootMargin: "100px", // Start loading slightly before video is visible
      },
    );

    // Start observing the video
    observer.observe(video);
  });
</script>
