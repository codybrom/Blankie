---
// Closing "download Blankie" card shared by the FAQ and guide-article pages.
// A caller customizes the blurb (and optionally the title). A guide passes its
// `platforms` so the matching store's badge comes first.
import { Image } from "astro:assets";
import icon from "../assets/brand/blankie-icon-v2.png";
import appStoreBadge from "../assets/brand/app-store-badge.svg";
import macAppStoreBadge from "../assets/brand/mac-app-store-badge.svg";

interface Props {
  title?: string;
  blurb: string;
  platforms?: string;
}

const { title = "Blankie is free, forever.", blurb, platforms } = Astro.props;

const listing = (platform: string) =>
  `https://apps.apple.com/us/app/blankie/id6740096581?platform=${platform}&itscg=30200&itsct=apps_box_badge&mttnsubad=6740096581`;
const stores = [
  {
    href: listing("iphone"),
    badge: appStoreBadge,
    label: "Download Blankie on the App Store",
    alt: "Download on the App Store",
  },
  {
    href: listing("mac"),
    badge: macAppStoreBadge,
    label: "Download Blankie on the Mac App Store",
    alt: "Download on the Mac App Store",
  },
];
// Always show both, so no reader thinks Blankie skips their device. A Mac guide
// leads with the Mac App Store.
if (platforms === "Mac") stores.reverse();
---

<section class="mx-auto mt-20 max-w-190 px-5 pb-24">
  <div
    class="relative flex items-center gap-7 overflow-hidden rounded-[22px] border border-hair px-8.5 py-7.5 shadow-[0_18px_44px_rgba(0,0,0,0.34),inset_0_0_0_0.5px_rgba(255,255,255,0.05)] max-[560px]:flex-col-reverse max-[560px]:items-start max-[560px]:gap-5 max-[560px]:p-6.5"
    style="background:radial-gradient(130% 150% at 100% 0%,color-mix(in srgb,var(--color-accent-blue) 16%,transparent),transparent 58%),var(--color-lift)"
  >
    <div class="min-w-0 flex-1">
      <h2 class="text-2xl/tight font-semibold tracking-tight text-fg-1">
        {title}
      </h2>
      <p class="mt-2 max-w-[54ch] text-sm/relaxed text-fg-2">{blurb}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        {
          stores.map(({ href, badge, label, alt }) => (
            <a
              class="inline-block transition hover:-translate-y-px"
              href={href}
              aria-label={label}
              data-app-store={badge === appStoreBadge ? "" : undefined}
            >
              <Image src={badge} alt={alt} class="h-11 w-auto" loading="lazy" />
            </a>
          ))
        }
      </div>
    </div>
    <Image
      src={icon}
      alt=""
      class="size-22 flex-none rounded-[22px] shadow-[0_12px_30px_rgba(0,0,0,0.45)] max-[560px]:size-18"
      width={92}
      height={92}
      densities={[1, 2, 3]}
    />
  </div>
</section>
