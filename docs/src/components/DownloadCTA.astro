---
// Closing "download Blankie" card shared by the FAQ and guide-article pages.
// A caller customizes the blurb (and optionally the title).
import { Image } from "astro:assets";
import icon from "../assets/blankie-icon-v2.png";
import appStoreBadge from "../assets/app-store-badge.svg";

interface Props {
  title?: string;
  blurb: string;
}

const { title = "Blankie is free, forever.", blurb } = Astro.props;

const appStore =
  "https://apps.apple.com/us/app/blankie/id6740096581?itscg=30200&itsct=apps_box_badge&mttnsubad=6740096581";
---

<section class="mx-auto mt-20 max-w-190 px-5 pb-24">
  <div
    class="relative flex items-center gap-7 overflow-hidden rounded-[22px] border border-hair px-8.5 py-7.5 shadow-[0_18px_44px_rgba(0,0,0,0.34),inset_0_0_0_0.5px_rgba(255,255,255,0.05)] max-[560px]:flex-col-reverse max-[560px]:items-start max-[560px]:gap-5 max-[560px]:p-6.5"
    style="background:radial-gradient(130% 150% at 100% 0%,color-mix(in srgb,var(--color-accent-blue) 16%,transparent),transparent 58%),var(--color-lift)"
  >
    <div class="min-w-0 flex-1">
      <h2 class="text-2xl/tight font-semibold tracking-tight text-fg-1">
        {title}
      </h2>
      <p class="mt-2 max-w-[54ch] text-sm/relaxed text-fg-2">{blurb}</p>
      <a
        class="mt-5 inline-block transition hover:-translate-y-px"
        href={appStore}
        aria-label="Download Blankie on the App Store"
      >
        <Image
          src={appStoreBadge}
          alt="Download on the App Store"
          class="h-11 w-auto"
          loading="lazy"
        />
      </a>
    </div>
    <Image
      src={icon}
      alt=""
      class="size-22 flex-none rounded-[22px] shadow-[0_12px_30px_rgba(0,0,0,0.45)] max-[560px]:size-18"
      width={92}
      height={92}
    />
  </div>
</section>
