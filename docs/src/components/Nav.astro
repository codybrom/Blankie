---
import { Image } from "astro:assets";
import icon from "../assets/icon.png";
import GithubStars from "./GithubStars.astro";
import { MobileNav, type NavLink } from "./MobileNav";
const currentPath = Astro.url.pathname;

const navLinks: NavLink[] = [
  { href: "/features/", label: "Features" },
  { href: "/faq/", label: "FAQ" },
  { href: "/i18n/", label: "Translations" },
  { href: "/contributing/", label: "Contribute" },
  { href: "/privacy/", label: "Privacy" },
  { href: "/credits/", label: "Credits" },
];
---

<header
  class="fixed top-0 z-50 w-full border-b border-white/10 bg-black/80 backdrop-blur-md"
>
  <div class="mx-auto max-w-7xl p-4 sm:px-6 lg:px-8">
    <nav class="flex items-center justify-between">
      <a
        href="/"
        class="flex items-center gap-x-3 text-white no-underline"
        id="logo-link"
      >
        <Image
          src={icon}
          alt="The Blankie app icon, which looks like a folded yellow blanket with one corner flipped over"
          width={40}
          height={33}
          loading="eager"
          class="size-10 object-contain"
          style={{ aspectRatio: "802/666" }}
        />
        <div class="flex items-baseline">
          <span class="text-2xl font-semibold tracking-tight">Blankie</span>
          <span class="ml-3 text-sm tracking-tight">for macOS</span>
        </div>
      </a>

      <!-- Desktop Navigation (lg+) -->
      <div class="hidden items-center gap-x-4 lg:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "text-sm text-white transition-colors duration-200 hover:text-yellow-500",
                { "text-yellow-500": currentPath === link.href },
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <span class="text-gray-400">•</span>
        <GithubStars />
        <a
          href="/?section=download"
          class="bg-primary-blue hover:bg-deep-blue rounded-full px-6 py-2 text-sm font-normal text-white no-underline transition-all duration-300"
        >
          Download
        </a>
      </div>

      <!-- Mobile/Tablet Navigation (<lg): Sheet drawer -->
      <div class="lg:hidden">
        <MobileNav client:load currentPath={currentPath} links={navLinks} />
      </div>
    </nav>
  </div>
</header>
