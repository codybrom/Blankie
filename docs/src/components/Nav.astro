---
import { Image } from "astro:assets";
import icon from "../assets/icon.png";
import GithubStars from "./GithubStars.astro";
import { MobileNav, type NavLink } from "./MobileNav";
const currentPath = Astro.url.pathname;

const navLinks: NavLink[] = [
  { href: "/features/", label: "Features" },
  { href: "/faq/", label: "FAQ" },
  { href: "/i18n/", label: "Translations" },
  { href: "/contributing/", label: "Contribute" },
  { href: "/privacy/", label: "Privacy" },
  { href: "/credits/", label: "Credits" },
];
---

<header
  class="bg-black/80 backdrop-blur-md border-b border-white/10 fixed w-full top-0 z-50"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <nav class="flex justify-between items-center">
      <a
        href="/"
        class="flex items-center gap-x-3 text-white no-underline"
        id="logo-link"
      >
        <Image
          src={icon}
          alt="The Blankie app icon, which looks like a folded yellow blanket with one corner flipped over"
          width={40}
          height={33}
          loading="eager"
          class="h-10 w-10 object-contain"
          style={{ aspectRatio: "802/666" }}
        />
        <div class="flex items-baseline">
          <span class="text-2xl font-semibold tracking-tight">Blankie</span>
          <span class="ml-3 text-sm tracking-tight">for macOS</span>
        </div>
      </a>

      <!-- Desktop Navigation (lg+) -->
      <div class="hidden lg:flex items-center gap-x-4">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "text-white text-sm hover:text-yellow-500 transition-colors duration-200",
                { "text-yellow-500": currentPath === link.href },
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <span class="text-gray-400">•</span>
        <GithubStars />
        <a
          href="/?section=download"
          class="bg-primary-blue text-white py-2 px-6 rounded-full text-sm font-normal transition-all duration-300 hover:bg-deep-blue no-underline"
        >
          Download
        </a>
      </div>

      <!-- Mobile/Tablet Navigation (<lg): Sheet drawer -->
      <div class="lg:hidden">
        <MobileNav client:load currentPath={currentPath} links={navLinks} />
      </div>
    </nav>
  </div>
</header>
