---
import { Image } from "astro:assets";
import icon from "../assets/blankie-icon-v2.png";
import { MobileNav, type NavLink } from "./MobileNav";
const currentPath = Astro.url.pathname;

const navLinks: NavLink[] = [
  { href: "/faq/", label: "FAQ" },
  { href: "/guides/", label: "Guides" },
  { href: "/press/", label: "Press" },
  { href: "/credits/", label: "Credits" },
];
---

<header
  class="bg-navy-deep/80 fixed top-0 z-50 w-full border-b border-white/10 backdrop-blur-md"
>
  <div class="mx-auto max-w-7xl p-4 sm:px-6 lg:px-8">
    <nav class="flex items-center justify-between">
      <a
        href="/"
        class="flex items-center gap-x-3 text-white no-underline"
        id="logo-link"
      >
        <Image
          src={icon}
          alt="The Blankie app icon, a yellow-to-blue gradient B with a cream moon on midnight navy"
          width={40}
          height={40}
          loading="eager"
          class="size-10 rounded-[22%] object-contain"
        />
        <span class="text-2xl font-semibold tracking-tight">Blankie</span>
      </a>

      <!-- Desktop Navigation (lg+) -->
      <div class="hidden items-center gap-x-1 lg:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "rounded-full px-3.5 py-2 text-sm font-medium no-underline transition-colors duration-200",
                currentPath === link.href
                  ? "bg-white/10 text-white"
                  : "text-white/65 hover:bg-white/5 hover:text-white",
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="/#download"
          class="bg-primary-blue hover:bg-deep-blue ml-2 rounded-full px-6 py-2 text-sm font-medium text-white no-underline transition-all duration-300"
        >
          Download
        </a>
      </div>

      <!-- Mobile/Tablet Navigation (<lg): Sheet drawer -->
      <div class="lg:hidden">
        <MobileNav client:load currentPath={currentPath} links={navLinks} />
      </div>
    </nav>
  </div>
</header>
