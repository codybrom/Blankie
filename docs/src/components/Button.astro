---
// Link styled as a button. shadcn-style cva variants matched to the site's
// existing buttons: `moon` (cream primary) and `glass` (frosted secondary).
import { cva } from "class-variance-authority";
import { cn } from "@/lib/utils";

const button = cva(
  "inline-flex items-center gap-2.5 rounded-xl font-semibold no-underline transition hover:-translate-y-0.5",
  {
    variants: {
      variant: {
        moon: "bg-moon text-midnight",
        glass:
          "border border-hair bg-glass-2 text-fg-1 hover:border-white/20 hover:bg-white/10",
      },
      size: {
        default: "px-5 py-3 text-sm",
        sm: "gap-2 px-4 py-2.5 text-sm",
      },
    },
    defaultVariants: { variant: "glass", size: "default" },
  },
);

const {
  href,
  variant,
  size,
  class: className,
  ...rest
} = Astro.props;
---

<a href={href} class={cn(button({ variant, size }), className)} {...rest}>
  <slot />
</a>
