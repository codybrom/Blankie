---
import { SEO } from "astro-seo";
import { type ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { markdownPathFor } from "@/utils/markdown-path";
import "../styles/global.css";

import favicon from "../assets/favicon.ico";
import favicon16 from "../assets/favicon-16.png";
import favicon32 from "../assets/favicon-32.png";
import favicon48 from "../assets/favicon-48.png";
import socialImage from "../assets/promo.jpg";

interface Props {
  title: string;
  description?: string;
  /** A page's hero art for its social card. Defaults to the site promo image. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Keeps a page out of search results (it still follows links). */
  noindex?: boolean;
}

const {
  title,
  description: customDescription,
  image: customImage,
  imageAlt: customImageAlt,
  noindex = false,
} = Astro.props;
const siteUrl = "https://blankie.rest";
const description =
  customDescription ||
  "Free, open-source ambient sound mixer for Mac, iPhone, iPad and CarPlay. Layer adjustable sounds like rain, waves and white noise for sleep and focus.";
// Social cards are cropped to the standard 1200×630 JPEG. og:image must be an
// absolute URL.
const OG = { width: 1200, height: 630 };
const social = await getImage({
  src: customImage ?? socialImage,
  ...OG,
  fit: "cover",
  format: "jpeg",
  quality: 85,
});
const socialSrc = `${siteUrl}${social.src}`;
const socialAlt =
  customImageAlt ||
  "Blankie, free ambient sounds for sleep and focus, on a MacBook and an iPhone Duo";
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
// Noindex pages (404, translation status) get no Markdown twin at build.
const markdownUrl = noindex
  ? undefined
  : `${siteUrl}/${markdownPathFor(Astro.url.pathname)}`;
---

<!doctype html>
<html lang="en-US" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' api.github.com;"
    />

    <link rel="icon" type="image/x-icon" href={favicon} />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16.src} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
    <link rel="icon" type="image/png" sizes="48x48" href={favicon48.src} />

    <SEO
      title={`Blankie - ${title}`}
      description={description}
      canonical={canonicalUrl}
      noindex={noindex}
      openGraph={{
        basic: {
          title: `Blankie - ${title}`,
          type: "website",
          image: socialSrc,
          url: canonicalUrl,
        },
        image: {
          alt: socialAlt,
          ...OG,
          type: "image/jpeg",
        },
        optional: {
          siteName: "Blankie",
          locale: "en_US",
          description,
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: "@blankie",
        title: `Blankie - ${title}`,
        description,
        image: socialSrc,
        imageAlt: socialAlt,
      }}
    />
    {
      markdownUrl && (
        <link rel="alternate" type="text/markdown" href={markdownUrl} />
      )
    }
    <link rel="ard" href="/.well-known/ard.json" />
  </head>
  <body class="overflow-x-hidden bg-navy-deep text-base">
    <!-- For agents that read the HTML. Hidden on screen and from screen readers. -->
    <div class="sr-only" aria-hidden="true">
      For an index of every page on this site, see <a
        href="/llms.txt"
        tabindex="-1">llms.txt</a
      >.{
        markdownUrl && (
          <>
            {" "}
            This page is also available as <a href={markdownUrl} tabindex="-1">
              Markdown
            </a>.
          </>
        )
      }
    </div>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script src="../scripts/nav.ts"></script>
    <script src="../scripts/webmcp.ts"></script>
  </body>
</html>
