{
  "name": "blankie-docs",
  "type": "module",
  "version": "2.1.1",
  "scripts": {
    "dev": "node prebuild.js && astro dev",
    "dev:bg": "node prebuild.js && astro dev --background",
    "build": "node prebuild.js && astro build",
    "preview": "astro preview",
    "deploy": "wrangler r2 object put blankie-assets/press/blankie-press-kit.zip --file=public/blankie-press-kit.zip --content-type=application/zip --remote && wrangler deploy",
    "astro": "astro",
    "extract-i18n": "node prebuild.js",
    "check": "astro check && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "update-deps": "ncu -u",
    "update-deps:minor": "ncu --target minor -u",
    "update-deps:interactive": "ncu -i"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@base-ui/react": "^1.9.0",
    "@lucide/astro": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.3",
    "astro-seo": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "glob": "^14.0.3",
    "iso-639-1-plus": "^3.0.5",
    "lucide-react": "^1.63.0",
    "marked": "^18.1.2",
    "marked-alert": "^2.1.2",
    "node-html-markdown": "^2.0.0",
    "node-html-parser": "^9.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fflate": "^0.8.3",
    "lucide-static": "^1.63.0",
    "npm-check-updates": "^23.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
