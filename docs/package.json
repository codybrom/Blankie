{
  "name": "blankie-docs",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node prebuild.js && astro dev",
    "dev:bg": "node prebuild.js && astro dev --background",
    "build": "node prebuild.js && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "extract-i18n": "node prebuild.js",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,astro}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "update-deps": "ncu -u",
    "update-deps:minor": "ncu --target minor -u",
    "update-deps:interactive": "ncu -i"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@base-ui/react": "^1.6.0",
    "@lucide/astro": "^1.25.0",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.1.3",
    "astro-seo": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "glob": "^13.0.6",
    "iso-639-1-plus": "^3.0.5",
    "lucide-react": "^1.21.0",
    "marked": "^18.0.5",
    "marked-alert": "^2.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "lucide-static": "^1.21.0",
    "npm-check-updates": "^22.2.7",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@lucide/astro": {
      "astro": "$astro"
    },
    "yaml-language-server": {
      "yaml": "^2.9.0"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "msw@2.14.6": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true
  }
}
