{
  "name": "blankie-docs",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node prebuild.js && astro dev",
    "build": "node prebuild.js && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "extract-i18n": "node prebuild.js",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,astro}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
