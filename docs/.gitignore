# build output
dist/
# local Wrangler state
.wrangler/
.dev.vars*
# generated types
.astro/

# generated outputs (but public/images is real, committed content —
# prebuild.js only generates public/i18n and never cleans the dir)
public/*
!public/images/
!public/robots.txt
!public/favicon.ico
!public/llms.txt
!public/.well-known/
!public/.assetsignore

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# github pages
.jekyll-cache/
_site/
.vercel
